{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klicker.uzh/evals/generic-tutor-case.schema.json",
  "title": "GenericTutorCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "task",
    "dialogHistory",
    "studentAttempt",
    "learningObjective",
    "allowedDisclosure",
    "rubric"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "description": "Original dataset or benchmark source, e.g. MathTutorBench/MathDial."
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "examples": ["math", "finance", "programming", "statistics", "writing"]
    },
    "subdomain": {
      "type": "string",
      "description": "Optional narrower topic, e.g. ratios, WACC, recursion."
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "The learner-facing task, problem, prompt, or scenario."
    },
    "sourceMaterial": {
      "type": "array",
      "description": "Optional authoritative snippets or retrieval-grounding context.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dialogHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["teacher", "student", "assistant", "system"]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "studentAttempt": {
      "type": "string",
      "description": "The current learner attempt or question to respond to."
    },
    "studentState": {
      "type": "string",
      "enum": [
        "exploring",
        "stuck",
        "misconception",
        "calculation_error",
        "verification_request",
        "final_answer_request",
        "unclear"
      ]
    },
    "learningObjective": {
      "type": "string",
      "minLength": 1
    },
    "expertSolution": {
      "type": "string",
      "description": "Complete expert answer, when available."
    },
    "expectedOutcome": {
      "description": "Structured target answer or outcome for solver/diagnostic probes."
    },
    "goldDiagnosis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isCorrect": { "type": "boolean" },
        "firstIssueStep": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "firstIssue": { "type": "string" },
        "misconception": { "type": "string" },
        "missingConcept": { "type": "string" }
      }
    },
    "goldNextMove": {
      "type": "string",
      "enum": [
        "ask",
        "hint",
        "simplify",
        "explain",
        "worked_micro_step",
        "self_explain",
        "reflect",
        "summarize"
      ]
    },
    "goldTutorResponse": {
      "type": "string",
      "description": "Optional reference teacher/tutor response."
    },
    "allowedDisclosure": {
      "type": "string",
      "enum": ["hint_only", "micro_step", "full_solution_allowed"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string" },
        "maxQuestions": { "type": "integer", "minimum": 0 },
        "maxSentences": { "type": "integer", "minimum": 1 },
        "requiresCitation": { "type": "boolean" },
        "forbidFinalAnswer": { "type": "boolean" },
        "outputFormat": { "type": "string" }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "weight"],
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "issue_diagnosis",
              "pedagogical_move",
              "scaffolding_quality",
              "question_quality",
              "answer_leakage_control",
              "correctness",
              "tone_and_clarity",
              "grounding"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
