{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (frontend-control)",
      "request": "launch",
      "type": "chrome",
      "url": "https://control.klicker.com",
      "webRoot": "${workspaceFolder}/apps/frontend-control"
    },
    {
      "name": "Launch Chrome (frontend-manage)",
      "request": "launch",
      "type": "chrome",
      "url": "https://manage.klicker.com",
      "webRoot": "${workspaceFolder}/apps/frontend-manage"
    },
    {
      "name": "Launch Chrome (frontend-pwa)",
      "request": "launch",
      "type": "chrome",
      "url": "https://pwa.klicker.com",
      "webRoot": "${workspaceFolder}/apps/frontend-pwa"
    },
    {
      "name": "Launch Chrome (office-addin)",
      "request": "launch",
      "type": "chrome",
      "url": "https://office.klicker.com",
      "webRoot": "${workspaceFolder}/apps/office-addin"
    },
    {
      "name": "Launch Chrome (chat)",
      "request": "launch",
      "type": "chrome",
      "url": "https://chat.klicker.com",
      "webRoot": "${workspaceFolder}/apps/chat"
    },
    {
      "name": "Attach to Node Functions",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "preLaunchTask": "func: host start"
    }
  ]
}
