{
  "name": "@klicker-uzh/lti-service",
  "version": "3.1.2-rc.2",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@klicker-uzh/types": "workspace:*",
    "@klicker-uzh/util": "workspace:*",
    "cross-env": "7.0.3",
    "ltijs": "5.9.9",
    "ltijs-sequelize": "2.4.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/ltijs": "^4.0.12",
    "@types/node": "^24.10.1",
    "nodemon": "~3.1.14",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "rollup-plugin-copy": "~3.5.0",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production pnpm run build:ts",
    "build:ts": "rollup -c",
    "check": "tsc --noEmit",
    "dev": "npm-run-all --parallel dev:build dev:run",
    "dev:build": "rollup -c --watch",
    "dev:infisical": "../../util/_run_with_infisical.sh --env dev pnpm run dev:lti",
    "dev:lti": "pnpm run dev",
    "dev:run": "nodemon -w dist/ --exec 'node ./dist/index.js'",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
