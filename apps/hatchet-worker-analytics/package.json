  ],
  "dependencies": {
    "@klicker-uzh/graphql": "workspace:*",
    "@klicker-uzh/hatchet": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
