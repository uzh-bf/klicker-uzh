/**
 * Renders the model-facing context that the chat route sends for each chat
 * mode into one Markdown file per mode (e.g. tutor.md), so evaluation runs can
 * inspect or reuse the exact system prompt without starting the application
 * stack. The klicker-uzh-catalyst evaluation passes these files to its judge.
 *
 * The script calls the chat app's own prompt compiler instead of copying its
 * templates, so the output stays faithful to `compileSystemPrompt` and
 * `trailingStepMessage`. Like the seeded Benibot, no lecturer prompts are set,
 * so the platform defaults for each mode are rendered.
 *
 * Run from apps/chat so tsx resolves its path aliases:
 *   node --import tsx scripts/render-chat-context.mts \
 *     --out ../../../klicker-uzh-catalyst/evaluation/data/context/chat_modes
 *
 * Options:
 *   --out <dir>          Output directory (required)
 *   --course <name>      Course display name (default: Testkurs)
 *   --tools <a,b>        Effective MCP tool names (default: EXPERT_df_fineco_expert)
 *   --modes <a,b>        Chat modes to render (default: tutor,explainer,quizzer)
 */
import { mkdirSync, writeFileSync } from 'node:fs'
import { dirname, join, relative, resolve } from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'
import { parseArgs } from 'node:util'

const CHAT_APP_DIR = resolve(dirname(fileURLToPath(import.meta.url)), '..')

// Mirrors seedChatbots.ts: the seeded Benibot leaves `systemPrompts` unset.
const systemPrompts = null

const { values } = parseArgs({
  options: {
    course: { type: 'string', default: 'Testkurs' },
    tools: { type: 'string', default: 'EXPERT_df_fineco_expert' },
    modes: { type: 'string', default: 'tutor,explainer,quizzer' },
    out: { type: 'string' },
  },
})

function list(value: string): string[] {
  return value
    .split(',')
    .map((item) => item.trim())
    .filter(Boolean)
}

const courseDisplayName = values.course
const toolNames = list(values.tools)
const modes = list(values.modes)
if (!values.out) {
  console.error('Error: --out <dir> is required')
  process.exit(1)
}
const outDir = resolve(values.out)

// promptTemplates.ts reads `src/prompts` relative to the working directory,
// and the compiler modules render their templates at import time.
process.chdir(CHAT_APP_DIR)
const chatModule = (path: string) =>
  pathToFileURL(join(CHAT_APP_DIR, 'src/lib/server', path)).href
const { compileSystemPrompt } = await import(
  chatModule('systemPromptCompiler.ts')
)
const { trailingStepMessage } = await import(chatModule('feedbackEvidence.ts'))

function fenced(text: string): string {
  const longestRun = Math.max(
    2,
    ...(text.match(/`+/g) ?? []).map((run) => run.length)
  )
  const fence = '`'.repeat(longestRun + 1)
  return `${fence}markdown\n${text.trim()}\n${fence}`
}

function displayPath(path: string): string {
  return relative(process.cwd(), path)
}

function header(mode: string): string {
  return [
    '<!-- Generated by klicker-uzh apps/chat/scripts/render-chat-context.mts; do not edit. -->',
    '',
    `- Course display name: ${courseDisplayName}`,
    `- Tool names: ${toolNames.length > 0 ? toolNames.map((name) => `\`${name}\``).join(', ') : '(none)'}`,
    '- Lecturer prompt: (none; platform defaults)',
    '',
    'The trailing system message is appended after the conversation and is',
    'shown without reuse evidence, which depends on the conversation.',
  ].join('\n')
}

mkdirSync(outDir, { recursive: true })

for (const mode of modes) {
  const systemPrompt = compileSystemPrompt(systemPrompts, mode, {
    courseDisplayName,
    toolNames,
  })
  const trailing = trailingStepMessage(mode, [])
  const outPath = join(outDir, `${mode}.md`)
  const sections = [
    `# Klicker chat context: ${mode}`,
    header(mode),
    `## System prompt\n\n${fenced(systemPrompt)}`,
    `## Trailing system message\n\n${fenced(trailing.content)}`,
  ]
  writeFileSync(outPath, `${sections.join('\n\n')}\n`)
  console.log(`Wrote ${displayPath(outPath)}`)
}
