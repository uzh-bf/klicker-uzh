{
  "name": "@klicker-uzh/olat-api",
  "version": "3.3.0-alpha.57",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@klicker-uzh/prisma": "workspace:*",
    "@klicker-uzh/types": "workspace:*",
    "@scalar/express-api-reference": "0.8.7",
    "dayjs": "1.11.13",
    "express": "4.21.1",
    "express-rate-limit": "7.5.0",
    "graphql": "16.9.0",
    "remeda": "2.15.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@redocly/cli": "~1.34.4",
    "@rollup/plugin-node-resolve": "~15.3.0",
    "@rollup/plugin-typescript": "~12.1.2",
    "@types/express": "^4.17.17",
    "@types/node": "^20.16.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "nodemon": "~3.1.7",
    "rollup": "~4.34.2",
    "supertest": "~7.1.1",
    "tsx": "~4.19.1",
    "typescript": "~5.6.3",
    "vitest": "~3.2.3"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c",
    "build:test": "pnpm run build",
    "check": "tsc --noEmit",
    "dev": "npm-run-all --parallel dev:ts dev:run",
    "dev:doppler": "doppler run --config dev -- pnpm run dev",
    "dev:offline": "pnpm run dev",
    "dev:run": "nodemon -w dist/ --exec 'node ./dist/index.js'",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "start": "node dist/index.js",
    "test": "bash run-tests.sh",
    "validate:openapi": "redocly lint static/openapi.yaml"
  },
  "engines": {
    "node": "=20"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
