  ],
  "dependencies": {
    "@azure/functions": "4.6.0",
    "@azure/service-bus": "7.9.5",
    "@klicker-uzh/util": "workspace:*",
    "@sentry/node": "7.103.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.1",
    "azure-functions-core-tools": "~4.0.6610",
    "cross-env": "~7.0.3",
    "dotenv": "~16.4.5",
    "eslint": "~9.30.1",
    "npm-run-all": "~4.1.5",
    "tsup": "~8.3.0",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build:funcs": "cross-env NODE_ENV=production tsup",
    "build:funcs:test": "pnpm run build",
