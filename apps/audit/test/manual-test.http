# Audit Service Manual API Tests
# Use with VS Code REST Client extension or any HTTP client
# Ensure the service is running on http://localhost:7080

@baseUrl = http://localhost:7080
@authToken = test-secret-token-123

### Health Check
GET {{baseUrl}}/healthz

### Readiness Check  
GET {{baseUrl}}/ready

### Prometheus Metrics
GET {{baseUrl}}/metrics

### Test Authentication - No Token (Should fail with 401)
POST {{baseUrl}}/audit
Content-Type: application/json

{
  "tenantId": "test-tenant",
  "subject": "user:test",
  "action": "test.action"
}

### Test Authentication - Wrong Token (Should fail with 401)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: wrong-token

{
  "tenantId": "test-tenant", 
  "subject": "user:test",
  "action": "test.action"
}

### Valid Minimal Audit Event
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-123",
  "subject": "user:john.doe@uzh.ch",
  "action": "session.started"
}

### Valid Full Audit Event
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-456",
  "subject": "instructor:alice.smith@uzh.ch", 
  "action": "quiz.created",
  "resourceId": "quiz-789",
  "sessionId": "session-abc123",
  "userId": "user-def456",
  "attributes": {
    "quizName": "Final Exam - Introduction to Computer Science",
    "questionCount": 25,
    "timeLimit": 90,
    "tags": ["exam", "cs101", "final"],
    "settings": {
      "randomizeQuestions": true,
      "showCorrectAnswers": false,
      "allowRetakes": false
    },
    "metadata": {
      "courseId": "CS-101",
      "semester": "HS2024",
      "department": "Computer Science"
    }
  }
}

### Event with Custom Timestamp
POST {{baseUrl}}/audit
Content-Type: application/json  
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-789",
  "subject": "system:backup-service",
  "action": "data.backup.completed",
  "timestamp": 1704067200000,
  "resourceId": "backup-job-001",
  "attributes": {
    "backupType": "full",
    "dataSize": "1.2GB",
    "duration": "45m"
  }
}

### Idempotent Event (Custom eventId)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-123",
  "subject": "student:bob.wilson@uzh.ch",
  "action": "answer.submitted", 
  "eventId": "answer-submission-unique-001",
  "resourceId": "question-42", 
  "sessionId": "live-session-xyz",
  "userId": "student-789",
  "attributes": {
    "questionType": "multiple-choice",
    "answerValue": "B",
    "timeSpent": 23,
    "confident": true
  }
}

### Repeat Idempotent Event (Same eventId - should return same result)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-123",
  "subject": "student:bob.wilson@uzh.ch", 
  "action": "answer.submitted",
  "eventId": "answer-submission-unique-001",
  "resourceId": "question-42",
  "sessionId": "live-session-xyz", 
  "userId": "student-789",
  "attributes": {
    "questionType": "multiple-choice",
    "answerValue": "B", 
    "timeSpent": 23,
    "confident": true
  }
}

### Invalid Request - Missing Required Field (Should fail with 400)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "test-tenant",
  "subject": "user:test"
  // Missing required "action" field
}

### Invalid Request - Field Too Long (Should fail with 400)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "this-tenant-id-is-way-too-long-and-exceeds-the-maximum-allowed-length-of-100-characters-which-should-cause-validation-to-fail",
  "subject": "user:test",
  "action": "test.action"
}

### Invalid Request - Bad JSON (Should fail with 400)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "test-tenant",
  "subject": "user:test",
  "action": "test.action",
  "attributes": {
    "invalid": json here
  }
}

### Performance Test Event (Large attributes)
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "performance-test",
  "subject": "system:performance-test",
  "action": "load.test",
  "attributes": {
    "testType": "performance",
    "payload": "This is a test payload to simulate a larger attributes object with some meaningful content that might be stored in audit events",
    "metrics": {
      "responseTime": 150,
      "throughput": 850,
      "errorRate": 0.02,
      "cpuUsage": 65.5,
      "memoryUsage": 78.2
    },
    "environment": {
      "region": "eu-central-1",
      "instance": "audit-service-1",
      "version": "1.0.0",
      "deployment": "production"
    },
    "tags": ["performance", "load-test", "monitoring", "metrics"],
    "notes": "This event tests the service's ability to handle larger attribute payloads while maintaining performance"
  }
}

### Delete Operation Event
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-tenant-456",
  "subject": "admin:carol.johnson@uzh.ch",
  "action": "course.deleted",
  "resourceId": "course-cs101-hs2024",
  "userId": "admin-123",
  "attributes": {
    "courseName": "Introduction to Computer Science",
    "studentCount": 120,
    "reason": "course-restructuring",
    "backupCreated": true
  }
}

### Security Event
POST {{baseUrl}}/audit
Content-Type: application/json
X-Internal-Token: {{authToken}}

{
  "tenantId": "klicker-security",
  "subject": "security:intrusion-detection",
  "action": "security.threat.detected",
  "resourceId": "firewall-rule-001",
  "attributes": {
    "threatType": "brute-force-login",
    "sourceIP": "192.168.1.100",
    "targetEndpoint": "/api/auth/login",
    "attemptCount": 50,
    "blocked": true,
    "severity": "high"
  }
}

# Note: Make sure to start the service and Azurite before running these tests:
# 1. docker-compose up -d  (start Azurite)  
# 2. pnpm dev or pnpm start (start audit service)
# 3. Test the endpoints above