{
  "name": "@klicker-uzh/audit",
  "version": "3.3.2",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@azure/data-tables": "13.2.2",
    "@hono/node-server": "1.19.0",
    "@hono/zod-validator": "0.4.1",
    "@klicker-uzh/util": "workspace:*",
    "hono": "4.9.6",
    "jose": "5.9.4",
    "pino": "9.9.5",
    "prom-client": "15.1.3",
    "ulidx": "2.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^20.19.11",
    "@vitest/ui": "~2.1.8",
    "cross-env": "~7.0.3",
    "dotenv": "~16.4.7",
    "nodemon": "~3.1.10",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "tsx": "~4.19.4",
    "typescript": "~5.6.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c",
    "build:test": "pnpm run build",
    "check": "tsc --noEmit",
    "dev": "npm-run-all --parallel dev:build dev:run",
    "dev:assessment": "pnpm run dev",
    "dev:build": "rollup -c --watch",
    "dev:doppler": "CONFIG=dev ../../../../util/_run_with_doppler.sh pnpm run dev",
    "dev:run": "nodemon -w dist/ --exec 'node --env-file .env ./dist/index.js'",
    "inspect:table": "tsx scripts/inspect-table.ts",
    "start": "node -r dotenv/config dist/index.js",
    "start:test": "node -r dotenv/config dist/index.js dotenv_config_path=.env.cypress",
    "test": "vitest run",
    "test:api": "vitest run test/api test/public-endpoint",
    "test:db": "vitest run test/database-verification",
    "test:integration": "vitest run test/integration test/scenarios test/performance",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch"
  },
  "engines": {
    "node": "=20"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
