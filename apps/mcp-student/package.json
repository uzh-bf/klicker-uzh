{
  "private": true,
  "name": "@klicker-uzh/mcp-student",
  "description": "Student-facing KlickerUZH MCP server",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@klicker-uzh/graphql": "workspace:*",
    "@klicker-uzh/types": "workspace:*",
    "@klicker-uzh/util": "workspace:*",
    "fastmcp": "3.15.2",
    "graphql": "16.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "~7.0.3",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc -p tsconfig.build.json",
    "build:test": "pnpm run build",
    "check": "tsc --noEmit",
    "dev": "../../util/_run_with_infisical.sh --env dev pnpm run dev:raw",
    "dev:raw": "cross-env NODE_ENV=development tsx --watch src/index.ts",
    "smoke:local": "tsx scripts/smoke.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "20.x"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
