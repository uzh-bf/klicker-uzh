{
  "name": "@klicker-uzh/office-addin",
  "version": "3.4.0-alpha.64",
  "license": "AGPL-3.0",
  "dependencies": {
    "@uzh-bf/design-system": "4.1.6",
    "core-js": "3.30.2",
    "es6-promise": "4.2.8",
    "formik": "2.4.9",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "~28.0.2",
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-replace": "~6.0.3",
    "@rollup/plugin-terser": "~0.4.4",
    "@rollup/plugin-typescript": "~12.1.4",
    "@tailwindcss/aspect-ratio": "~0.4.2",
    "@tailwindcss/forms": "~0.5.11",
    "@tailwindcss/postcss": "~4.1.11",
    "@tailwindcss/typography": "~0.5.19",
    "@types/node": "^24.10.1",
    "@types/office-js": "^1.0.591",
    "@types/office-runtime": "^1.0.37",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "~8.35.1",
    "@typescript-eslint/parser": "~8.35.1",
    "autoprefixer": "~10.4.20",
    "cross-env": "~7.0.3",
    "cssnano": "~6.0.1",
    "eslint": "~9.30.1",
    "eslint-plugin-office-addins": "~3.0.3",
    "eslint-plugin-react-hooks": "~5.1.0",
    "eslint-plugin-react-refresh": "~0.4.18",
    "office-addin-cli": "~1.6.5",
    "office-addin-debugging": "~5.1.6",
    "office-addin-dev-certs": "~1.13.5",
    "office-addin-lint": "~2.3.5",
    "office-addin-manifest": "~1.13.6",
    "postcss": "~8.4.47",
    "postcss-import": "~16.1.0",
    "rollup": "~4.34.9",
    "rollup-plugin-copy": "~3.5.0",
    "rollup-plugin-delete": "~2.1.0",
    "rollup-plugin-livereload": "~2.0.5",
    "rollup-plugin-postcss": "~4.0.2",
    "rollup-plugin-serve-proxy": "~1.1.4",
    "tailwindcss": "~4.1.11",
    "tw-animate-css": "~1.3.4",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build:dev": "rollup -c -w --environment BUILD:development",
    "build:office": "rollup -c --environment BUILD:production",
    "check": "tsc --noEmit",
    "clean:cache": "node scripts/clean-cache.js",
    "prettier": "office-addin-lint prettier",
    "preview": "cross-env NODE_ENV=production rollup -c",
    "start:content": "office-addin-debugging start src/manifest-content.xml",
    "start:content:desktop": "office-addin-debugging start src/manifest-content.xml desktop",
    "start:content:web": "office-addin-debugging start src/manifest-content.xml web",
    "start:taskpane": "office-addin-debugging start src/manifest-taskpane.xml",
    "start:taskpane:desktop": "office-addin-debugging start src/manifest-taskpane.xml desktop",
    "start:taskpane:web": "office-addin-debugging start src/manifest-taskpane.xml web",
    "start:web": "office-addin-debugging start src/manifest.xml web",
    "stop:content": "office-addin-debugging stop src/manifest-content.xml",
    "stop:taskpane": "office-addin-debugging stop src/manifest-taskpane.xml",
    "validate:content": "office-addin-manifest validate src/manifest-content.xml",
    "validate:taskpane": "office-addin-manifest validate src/manifest-taskpane.xml"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "node": "24.16.0",
    "pnpm": "11.5.0"
  },
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3020
  },
  "type": "module"
}
