{
  "name": "@klicker-uzh/office-addin",
  "version": "3.4.0-alpha.66",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@rollup/plugin-terser": "~0.4.4",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/office-js": "^1.0.599",
    "cross-env": "~7.0.3",
    "eslint": "~9.30.1",
    "eslint-plugin-office-addins": "~4.0.10",
    "office-addin-dev-certs": "~2.0.10",
    "office-addin-manifest": "~2.1.6",
    "rollup": "~4.62.2",
    "rollup-plugin-serve": "~3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.63.0"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c",
    "build:dev": "cross-env NODE_ENV=development rollup -c",
    "build:docs": "cross-env NODE_ENV=production rollup -c && node scripts/sync-docs.mjs",
    "build:test": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit",
    "clean:cache": "office-addin-dev-certs uninstall && office-addin-dev-certs install",
    "dev": "cross-env NODE_ENV=development rollup -c --watch",
    "lint": "eslint src/content",
    "lint:fix": "eslint --fix src/content",
    "test": "node --test tests/*.test.mjs",
    "test:run": "node --test tests/*.test.mjs",
    "validate": "office-addin-manifest validate manifest.xml",
    "verify:docs": "node scripts/sync-docs.mjs --check"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
