enum DiscussionSpaceType {
  COURSE
}

enum DiscussionScopeType {
  COURSE
  PRACTICE_STACK
  EXTERNAL_BLOCK
}

enum DiscussionEventType {
  THREAD_CREATED
  THREAD_DELETED
  REPLY_CREATED
  REPLY_DELETED
  THREAD_UPVOTED
  REPLY_UPVOTED
  ANON_RATE_LIMITED
}

model DiscussionSpace {
  id Int @id @default(autoincrement())

  spaceType DiscussionSpaceType

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @unique @db.Uuid

  scopes DiscussionScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceType])
}

model DiscussionScope {
  id Int @id @default(autoincrement())

  space   DiscussionSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  spaceId Int

  scopeType  DiscussionScopeType
  scopeKey   String
  scopeLabel String

  stackId        Int?
  externalSource String?
  externalRef    String?

  threads DiscussionThread[]
  events  DiscussionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, scopeKey])
  @@index([spaceId, scopeType])
}

model DiscussionThread {
  id Int @id @default(autoincrement())

  scope   DiscussionScope @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scopeId Int

  content String

  isAnonymous           Boolean @default(false)
  authorFingerprintHash String?

  authorParticipant   Participant? @relation("DiscussionThreadAuthor", fields: [authorParticipantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorParticipantId String?      @db.Uuid

  upvotes    Int @default(0)
  replyCount Int @default(0)

  lastActivityAt DateTime @default(now())

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  replies DiscussionReply[]
  votes   DiscussionThreadVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scopeId, lastActivityAt])
  @@index([authorParticipantId])
}

model DiscussionReply {
  id Int @id @default(autoincrement())

  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  threadId Int

  content String

  isAnonymous           Boolean @default(false)
  authorFingerprintHash String?

  authorParticipant   Participant? @relation("DiscussionReplyAuthor", fields: [authorParticipantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorParticipantId String?      @db.Uuid

  upvotes Int @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  votes DiscussionReplyVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  @@index([authorParticipantId])
}

model DiscussionThreadVote {
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  threadId Int

  participant   Participant @relation("DiscussionThreadVoteParticipant", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  createdAt DateTime @default(now())

  @@id([threadId, participantId])
  @@index([participantId, createdAt])
}

model DiscussionReplyVote {
  reply   DiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replyId Int

  participant   Participant @relation("DiscussionReplyVoteParticipant", fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  createdAt DateTime @default(now())

  @@id([replyId, participantId])
  @@index([participantId, createdAt])
}

model DiscussionEvent {
  id Int @id @default(autoincrement())

  scope   DiscussionScope @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scopeId Int

  subjectId Int?

  participant   Participant? @relation("DiscussionEventParticipant", fields: [participantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  participantId String?      @db.Uuid

  eventType DiscussionEventType
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([scopeId, createdAt])
  @@index([eventType, subjectId, createdAt])
  @@index([participantId, createdAt])
}
