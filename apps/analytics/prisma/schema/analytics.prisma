enum AnalyticsType {
  DAILY
  WEEKLY
  MONTHLY
  COURSE // analytics for the entire course
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
}

enum PerformanceLevel {
  LOW
  MEDIUM
  HIGH
}

// All metrics are based on logged in participant activity only
model ParticipantAnalytics {
  id   Int           @id @default(autoincrement())
  type AnalyticsType

  timestamp  DateTime @db.Date
  computedAt DateTime @default(now()) @db.Date

  // unsolvedQuestionsCount = AggregatedAnalytics.totalElementsAvailable - responseCount
  trialsCount   Int // total number of questions attempted
  responseCount Int // total number of unique questions attempted

  // summed across all question attempts (non-unique)
  totalScore  Int
  totalPoints Int
  totalXp     Int

  // responseCount = meanCorrectCount + meanPartialCorrectCount + meanWrongCount
  meanCorrectCount        Float @db.Real // mean over responses to same question and sum over all questions
  meanPartialCorrectCount Float @db.Real // mean over responses to same question and sum over all questions
  meanWrongCount          Float @db.Real // mean over responses to same question and sum over all questions

  // divide by responseCount to get the correctness rate (COURSE LEVEL ONLY)
  // values can be computed based on firstCorrectness and lastCorrectness on QuestionResponse
  firstCorrectCount Float? @db.Real // aggregated over all questions (sum)
  lastCorrectCount  Float? @db.Real // aggregated over all questions (sum)
  firstWrongCount   Float? @db.Real // aggregated over all questions (sum)
  lastWrongCount    Float? @db.Real // aggregated over all questions (sum)

  competencyAnalytics CompetencyAnalytics[]

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, courseId, participantId, timestamp])
  // Course-centric API reads (dashboards) — the unique above is type-leading.
  @@index([courseId, type, timestamp])
}

// All metrics are based on logged in participant activity only
model AggregatedAnalytics {
  id   Int           @id @default(autoincrement())
  type AnalyticsType

  // all quantities are defined as the values at the end of the selected timeframe
  timestamp              DateTime @db.Date
  computedAt             DateTime @default(now()) @db.Date
  responseCount          Int
  participantCount       Int
  totalScore             Int
  totalPoints            Int
  totalXp                Int
  totalElementsAvailable Int // total number of elements available at the end of selected timeframe (practice quizzes & microlearnings != instances linked to course)

  aggregatedCompetencyAnalytics AggregatedCompetencyAnalytics[]

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, courseId, timestamp])
  // Course-centric API reads — the unique above is type-leading.
  @@index([courseId, type, timestamp])
}

model CompetencyAnalytics {
  id Int @id @default(autoincrement())

  unsolvedQuestionsCount  Int @db.SmallInt
  lastCorrectCount        Int @db.SmallInt
  lastPartialCorrectCount Int @db.SmallInt
  lastWrongCount          Int @db.SmallInt

  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  competencyId Int

  // all metrics are only computed on weekly and course-wide basis
  participantAnalytics   ParticipantAnalytics @relation(fields: [participantAnalyticsId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantAnalyticsId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competencyId, participantAnalyticsId])
}

model AggregatedCompetencyAnalytics {
  id Int @id @default(autoincrement())

  meanUnsolvedQuestionsCount  Int @db.SmallInt
  meanLastCorrectCount        Int @db.SmallInt
  meanLastPartialCorrectCount Int @db.SmallInt
  meanLastWrongCount          Int @db.SmallInt

  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  competencyId Int

  // all metrics are only computed on weekly and course-wide basis
  aggregatedAnalytics   AggregatedAnalytics @relation(fields: [aggregatedAnalyticsId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aggregatedAnalyticsId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competencyId, aggregatedAnalyticsId])
}

model ParticipantCourseAnalytics {
  id Int @id @default(autoincrement())

  activeWeeks        Int
  activeDaysPerWeek  Float @db.Real
  meanElementsPerDay Float @db.Real

  activityLevel ActivityLevel

  hasChatActivity Boolean @default(false) // set by script 11 (chat × quiz correlation)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, participantId])
}

model AggregatedCourseAnalytics {
  id Int @id @default(autoincrement())

  courseParticipantCount Int // total number of participants that have a participation in the course
  activityMonday         Float @db.Real // average number of participants that have been active on Monday
  activityTuesday        Float @db.Real // ... on Tuesday
  activityWednesday      Float @db.Real // ... on Wednesday
  activityThursday       Float @db.Real // ... on Thursday
  activityFriday         Float @db.Real // ... on Friday
  activitySaturday       Float @db.Real // ... on Saturday
  activitySunday         Float @db.Real // ... on Sunday

  // Modality footprint (set by script 13)
  chatbotCount         Int @default(0)
  practiceQuizCount    Int @default(0)
  microLearningCount   Int @default(0)
  liveQuizCount        Int @default(0)
  chatParticipantCount Int @default(0)
  quizParticipantCount Int @default(0)
  bothChatAndQuizCount Int @default(0)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParticipantPerformance {
  id Int @id @default(autoincrement())

  firstErrorRate   Float            @db.Real // fraction of first responses that were incorrect (in the corresponding course)
  firstPerformance PerformanceLevel // performance level based on quantiles of first error rate distributions over all participants

  lastErrorRate   Float            @db.Real // fraction of last responses that were incorrect
  lastPerformance PerformanceLevel

  totalErrorRate   Float            @db.Real // fraction of all responses that were incorrect
  totalPerformance PerformanceLevel

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, courseId])
}

model InstancePerformance {
  id Int @id @default(autoincrement())

  responseCount    Int // total number of responses to this instance
  averageTimeSpent Float @db.Real // average time students spent on this instance

  firstErrorRate   Float? @db.Real // fraction of wrong answers to this instance (first attempt, PQ only)
  firstPartialRate Float? @db.Real // fraction of partially correct answers to this instance (first attempt, PQ only)
  firstCorrectRate Float? @db.Real // fraction of correct answers to this instance (first attempt, PQ only)

  lastErrorRate   Float? @db.Real // ... (last attempt, PQ only)
  lastPartialRate Float? @db.Real // ... (last attempt, PQ only)
  lastCorrectRate Float? @db.Real // ... (last attempt, PQ only)

  totalErrorRate   Float @db.Real // ... (all attempts)
  totalPartialRate Float @db.Real // ... (all attempts)
  totalCorrectRate Float @db.Real // ... (all attempts)

  instance   ElementInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  instanceId Int             @unique

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityPerformance {
  id Int @id @default(autoincrement())

  firstErrorRate   Float? @db.Real // fraction of wrong answers to instances in this activity (first attempt, PQ only)
  firstPartialRate Float? @db.Real // fraction of partially correct answers to instances in this activity (first attempt, PQ only)
  firstCorrectRate Float? @db.Real // fraction of correct answers to instances in this activity (first attempt, PQ only)

  lastErrorRate   Float? @db.Real // ... (last attempt, PQ only)
  lastPartialRate Float? @db.Real // ... (last attempt, PQ only)
  lastCorrectRate Float? @db.Real // ... (last attempt, PQ only)

  totalErrorRate   Float @db.Real // ... (all attempts)
  totalPartialRate Float @db.Real // ... (all attempts)
  totalCorrectRate Float @db.Real // ... (all attempts)

  practiceQuiz   PracticeQuiz? @relation(fields: [practiceQuizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  practiceQuizId String?       @unique @db.Uuid

  microLearning   MicroLearning? @relation(fields: [microLearningId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  microLearningId String?        @unique @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParticipantActivityPerformance {
  id Int @id @default(autoincrement())

  totalScore Int // total score of the participant in this activity (sum of all instance scores)
  completion Float @db.Real // fraction of instances completed (answered at least once) by the participant

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  practiceQuiz   PracticeQuiz? @relation(fields: [practiceQuizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  practiceQuizId String?       @db.Uuid

  microLearning   MicroLearning? @relation(fields: [microLearningId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  microLearningId String?        @db.Uuid

  @@unique([participantId, practiceQuizId])
  @@unique([participantId, microLearningId])
}

model ActivityProgress {
  id Int @id @default(autoincrement())

  totalCourseParticipants Int
  startedCount            Int
  completedCount          Int
  repeatedCount           Int?

  practiceQuiz   PracticeQuiz? @relation(fields: [practiceQuizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  practiceQuizId String?       @unique @db.Uuid

  microLearning   MicroLearning? @relation(fields: [microLearningId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  microLearningId String?        @unique @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompetencyTree {
  id Int @id @default(autoincrement())

  name        String
  description String?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId String @db.Uuid

  competencies Competency[]
  courses      Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
}

model Competency {
  id Int @id @default(autoincrement())

  name        String
  description String?

  // left and right values for nested set queries
  lft Int
  rgt Int

  analytics           CompetencyAnalytics[]
  aggregatedAnalytics AggregatedCompetencyAnalytics[]

  tree   CompetencyTree @relation(fields: [treeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  treeId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([treeId, lft, rgt])
  @@unique([treeId, name])
  @@index([treeId, lft])
  @@index([treeId, rgt])
}

// ----- CHAT ANALYTICS -----

enum ChatDoseBucket {
  NONE
  LOW
  MED
  HIGH
}

// Per-participant x per-chatbot engagement + cost rollup over a DAILY/WEEKLY/MONTHLY/COURSE window.
// Only populated for participants with an accepted disclaimer on the chatbot.
model ParticipantChatAnalytics {
  id   Int           @id @default(autoincrement())
  type AnalyticsType

  timestamp DateTime @db.Date

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  // Engagement
  userMessages      Int       @default(0)
  assistantMessages Int       @default(0)
  threads           Int       @default(0)
  distinctDays      Int       @default(0) // days the participant sent >=1 user msg in the window
  firstMessageAt    DateTime?
  lastMessageAt     DateTime?

  // User-message length distribution (drives §10.5)
  msgLenMedian Float? @db.Real
  msgLenP90    Float? @db.Real
  msgLenP99    Float? @db.Real

  // Thread structure
  messagesPerThreadP50 Float? @db.Real
  messagesPerThreadP90 Float? @db.Real

  // Behavioural mix
  chatModeCounts        Json @default("{}")
  reasoningEffortCounts Json @default("{}")
  attachmentCount       Int  @default(0)
  toolCallCount         Int  @default(0)

  // Cost
  totalCreditsUsed Decimal @default(0) @db.Decimal(18, 6)
  creditsExhausted Boolean @default(false) // hit current=0 at least once in window

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, participantId, chatbotId, timestamp])
  @@index([chatbotId, type, timestamp])
  @@index([courseId, type, timestamp])
}

// Per-chatbot rollup over a DAILY/WEEKLY/MONTHLY/COURSE window.
model AggregatedChatbotAnalytics {
  id   Int           @id @default(autoincrement())
  type AnalyticsType

  timestamp DateTime @db.Date

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  // Adoption
  activeParticipants    Int @default(0)
  newParticipants       Int @default(0) // first user-msg in this window (WEEKLY only meaningful)
  returningParticipants Int @default(0)
  threads               Int @default(0)
  userMessages          Int @default(0)
  assistantMessages     Int @default(0)

  // Cost / compliance
  totalCreditsUsed        Decimal @default(0) @db.Decimal(18, 6)
  creditExhaustionRate    Float?  @db.Real // share of users hitting current=0 during window
  disclaimerAcceptedCount Int     @default(0)
  disclaimerDeclinedCount Int     @default(0)

  // Distributions (Json — bounded size, schema-flexible)
  hourOfDayDistribution       Json @default("{}") // {"1":[24 ints], ..., "7":[24 ints]}  (ISO weekday x hour)
  modelDistribution           Json @default("{}") // {"<modelId>": <count>}
  modeDistribution            Json @default("{}") // {"<chatMode>": <count>}
  reasoningEffortDistribution Json @default("{}") // {"<effort>": <count>}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, chatbotId, timestamp])
  @@index([courseId, type, timestamp])
}

// Aggregate topic clusters over user-authored ChatMessage content.
// Per §3.9 privacy guard: clusters with <5 distinct participants are collapsed to "Other".
model ChatTopicCluster {
  id   Int           @id @default(autoincrement())
  type AnalyticsType // always COURSE at first; WEEKLY possible later

  timestamp DateTime @db.Date

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  clusterIndex             Int
  clusterLabel             String // NLP-derived short label
  messageCount             Int
  participantCount         Int // >=5 enforced by the clustering pipeline
  representativeParaphrase String? // rewritten; never a verbatim message. Stage B may fill this.
  embeddingCentroid        Bytes? // optional, for future similarity queries

  createdAt DateTime @default(now())

  @@unique([type, chatbotId, timestamp, clusterIndex])
  @@index([chatbotId, timestamp])
}

// Per-participant-per-course outcome with chat dose bucket.
// Built by Stage B script 11 as the join between ParticipantChatAnalytics and ParticipantPerformance.
model ParticipantChatOutcome {
  id Int @id @default(autoincrement())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  chatMessagesInCourse Int            @default(0)
  chatDoseBucket       ChatDoseBucket

  firstErrorRate Float? @db.Real // mirrored from ParticipantPerformance
  lastErrorRate  Float? @db.Real
  errorRateDelta Float? @db.Real // lastErrorRate - firstErrorRate

  hasBothModalities Boolean @default(false) // §10.4 — same participant in chat AND in quiz for this course

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, courseId])
  @@index([courseId, chatDoseBucket])
}

// ----- LIVE QUIZ ANALYTICS (assessment mode only) -----

model ParticipantLiveQuizAnalytics {
  id Int @id @default(autoincrement())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  liveQuiz   LiveQuiz @relation(fields: [liveQuizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  liveQuizId String   @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  totalResponses         Int    @default(0)
  firstCorrectCount      Int    @default(0)
  lastCorrectCount       Int    @default(0)
  averageTimeSpent       Float? @db.Real
  totalBasePoints        Int    @default(0)
  totalCorrectnessPoints Int    @default(0)
  totalBonusPoints       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, liveQuizId])
  @@index([courseId])
  @@index([liveQuizId])
}

model AggregatedLiveQuizAnalytics {
  id Int @id @default(autoincrement())

  liveQuiz   LiveQuiz @relation(fields: [liveQuizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  liveQuizId String   @unique @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  participantCount     Int    @default(0)
  responseCount        Int    @default(0)
  meanFirstCorrectness Float? @db.Real
  meanLastCorrectness  Float? @db.Real
  lateSubmitterRate    Float? @db.Real

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// ----- PLATFORM-LEVEL SEMESTER ROLLUP -----

model PlatformSemesterAnalytics {
  id Int @id @default(autoincrement())

  semesterLabel String   @unique // "HS25", "FS26", ...
  semesterStart DateTime
  semesterEnd   DateTime

  quizResponseRows             Int @default(0)
  quizTrials                   Int @default(0)
  quizDistinctParticipants     Int @default(0)
  liveQuizResponses            Int @default(0)
  liveQuizDistinctParticipants Int @default(0)
  chatMessages                 Int @default(0)
  chatDistinctParticipants     Int @default(0)

  activeCourses           Int @default(0)
  coursesWithChatbot      Int @default(0)
  coursesWithLiveQuiz     Int @default(0)
  coursesWithQuizActivity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
