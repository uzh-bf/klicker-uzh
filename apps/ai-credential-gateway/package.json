{
  "name": "@klicker-uzh/ai-credential-gateway",
  "version": "3.4.0-alpha.0",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@klicker-uzh/util": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^24.10.1",
    "rollup": "~4.34.9",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "run-s --npm-path pnpm build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit --tsBuildInfoFile dist/tsconfig.check.tsbuildinfo",
    "dev": "run-p --npm-path pnpm dev:ts",
    "dev:offline": "pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development tsx --watch --env-file=.env src/index.ts",
    "test": "vitest run --reporter=verbose"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
