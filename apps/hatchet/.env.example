# Hatchet Environment Configuration
# Copy this file to .env and fill in your actual values

# Log level for Hatchet (INFO, OFF, DEBUG, WARN, ERROR)
HATCHET_LOG_LEVEL=INFO

# TLS strategy
HATCHET_CLIENT_TLS_STRATEGY=none

# Hatchet client token for authentication
HATCHET_CLIENT_TOKEN=your_hatchet_token_here
