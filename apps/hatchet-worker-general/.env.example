HATCHET_CLIENT_TOKEN=__HATCHET_CLIENT_TOKEN__
HATCHET_CLIENT_HOST_PORT=localhost:7077
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_LOG_LEVEL=WARN
HATCHET_WORKFLOWS=
LOG_LEVEL=info

# Dedicated assessment-audit worker only. Azure authentication uses
# DefaultAzureCredential; never put a storage key or connection string here.
ASSESSMENT_AUDIT_WORKER_ENABLED=false
ASSESSMENT_AUDIT_ENVIRONMENT=dev
ASSESSMENT_AUDIT_METRICS_PORT=
ASSESSMENT_AUDIT_TABLE_ENDPOINT=https://example.table.core.windows.net
ASSESSMENT_AUDIT_BLOB_ENDPOINT=https://example.blob.core.windows.net
AZURE_TOKEN_CREDENTIALS=WorkloadIdentityCredential

DATABASE_URL="postgres://klicker-prod:klicker@localhost:5432/klicker-prod"
APP_SECRET="abcd"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_CACHE_HOST="localhost"
REDIS_CACHE_PORT=6380

APP_ORIGIN_AUTH="http://127.0.0.1:3010"
APP_ORIGIN_API="http://127.0.0.1:3000"
APP_ORIGIN_LTI="http://127.0.0.1:4000"
APP_ORIGIN_PWA="http://127.0.0.1:3001"
APP_ORIGIN_MANAGE="http://127.0.0.1:3002"
APP_ORIGIN_CONTROL="http://127.0.0.1:3003"
APP_ORIGIN_ASSESSMENT_API="http://127.0.0.1:3000"
APP_ORIGIN_ASSESSMENT_PWA="http://127.0.0.1:3001"
