# Committed devcontainer environment — safe, dev-only values, NO real secrets.
# Loaded by the `app` service (docker-compose env_file) and inherited by every
# app `turbo dev` starts. The "example that just works"; real secrets stay in
# Infisical/Doppler for non-container workflows.
#
# NOTE: lifecycle hooks re-source this file (set -a; . devcontainer.env; set +a)
# because DevPod truncates env_file values at '='. (GOTCHAS #1)
#
# Scope: every routed app plus the two Hatchet workers and both MCP servers
# (olat-api, response-api, 2 hatchet workers, mcp-lecturer, mcp-student). Infra
# is reached by COMPOSE DNS (postgres / redis_* / hatchet / mailhog).
# Browser-facing URLs are the devrouter https hosts; server-side app->app calls
# use localhost:<port> (all apps share this container) so they never leave it.

# --- Dev mode. The backend gates `allowArbitraryOperations` (graphql-yoga
# persisted-operations plugin) on NODE_ENV; without development it answers every
# non-persisted query with `PersistedQueryOnly`, and the frontends send full
# queries in dev — so they must run as development. (next dev forces this for the
# Next apps anyway; this also covers the backend node process.) ---
NODE_ENV=development
KB_SOURCE_GATEWAY_URL=http://localhost:3000
KB_SOURCE_GATEWAY_KEY=dev-kb-source-gateway-key
KB_WEBHOOK_SECRET=dev-kb-webhook-secret
# Local-only producer connection. Start the sibling data-ingestion resource API
# with util/start-local-kb-ingestion.sh before triggering a resource ingest.
KB_INGESTION_API_URL=http://host.docker.internal:18080
KB_INGESTION_API_KEY=dev-local-kb-ingestion-api-key
KB_INGESTION_PROJECT_ID=klicker-course-materials

# --- Database (postgres service) ---
DATABASE_URL=postgres://klicker-prod:klicker@postgres:5432/klicker-prod
SHADOW_DATABASE_URL=postgres://klicker-prod:klicker@postgres:5432/shadow

# --- Shared dev secrets (NOT real). APP_SECRET signs/verifies student MCP
# JWTs and is the lecturer MCP fallback when MCP_LECTURER_JWT_SECRET is unset;
# apps/chat uses the matching secret when minting each token. ---
APP_SECRET=abcd
CRON_TOKEN=abcd

# --- Redis (compose DNS; all three listen on the in-network port 6379) ---
REDIS_HOST=redis_exec
REDIS_PORT=6379
REDIS_CACHE_HOST=redis_cache
REDIS_CACHE_PORT=6379
REDIS_ASSESSMENT_HOST=redis_assessment
REDIS_ASSESSMENT_PORT=6379

# --- Hatchet (compose DNS gRPC). HATCHET_CLIENT_TOKEN is injected at runtime by
# post-start from .devcontainer/.hatchet.env (minted by hatchet-lite-dev at /config/authdisabled-token). ---
HATCHET_CLIENT_HOST_PORT=hatchet:7077
HATCHET_CLIENT_TLS_STRATEGY=none

# --- Email (mailhog) ---
EMAIL_HOST=mailhog
EMAIL_PORT=1025

# --- Backend origins + subdomain matching (browser-facing devrouter hosts).
# The backend substring-matches the request Origin against APP_*_SUBDOMAIN.
# APP_ORIGIN_AUTH also doubles as the JWT issuer for both MCP servers
# (apps/mcp-{lecturer,student}/src/config.ts and
# apps/chat/src/lib/server/mcpAuthMint.ts); post-start.sh overrides it to the
# workspace-namespaced origin in linked worktrees, so all processes still
# agree on the same issuer value. ---
APP_ORIGIN_API=https://api.klicker.localhost
APP_ORIGIN_AUTH=https://auth.klicker.localhost
APP_ORIGIN_PWA=https://pwa.klicker.localhost
APP_ORIGIN_MANAGE=https://manage.klicker.localhost
APP_ORIGIN_CONTROL=https://control.klicker.localhost
APP_ORIGIN_ASSESSMENT_API=https://api.klicker.localhost
APP_ORIGIN_ASSESSMENT_PWA=https://pwa.klicker.localhost
APP_MANAGE_SUBDOMAIN=manage.klicker.localhost
APP_STUDENT_SUBDOMAIN=pwa.klicker.localhost
APP_CONTROL_SUBDOMAIN=control.klicker.localhost

# --- Auth app (NextAuth). NEXTAUTH_URL drives the shared cookie domain
# (auth.klicker.localhost -> cookie domain klicker.localhost, spanning all apps).
# The hardcoded allowed-host defaults only know klicker.com, so add the
# *.klicker.localhost hosts explicitly. EduID omitted -> credentials login. ---
NEXTAUTH_URL=https://auth.klicker.localhost
AUTH_LECTURER_ALLOWED_HOSTS=manage.klicker.localhost,127.0.0.1:3002
AUTH_STUDENT_ALLOWED_HOSTS=pwa.klicker.localhost,127.0.0.1:3001

# --- Frontends: public (browser) API/auth URLs + shared cookie domain ---
COOKIE_DOMAIN=klicker.localhost
# Must include the /api/graphql path — the backend mounts Yoga there (app.ts).
NEXT_PUBLIC_API_URL=https://api.klicker.localhost/api/graphql
NEXT_PUBLIC_AUTH_URL=https://auth.klicker.localhost
NEXT_PUBLIC_MANAGE_URL=https://manage.klicker.localhost
NEXT_PUBLIC_PWA_URL=https://pwa.klicker.localhost
NEXT_PUBLIC_ASSESSMENT_URL=https://pwa.klicker.localhost
NEXT_PUBLIC_CONTROL_URL=https://control.klicker.localhost
NEXT_PUBLIC_ADD_RESPONSE_URL=https://response-api.klicker.localhost

# --- SSR app->app stays intra-container (bypasses devrouter, no cross-host TLS) ---
API_URL_SSR=http://localhost:3000/api/graphql

# --- PHASE 2 apps (olat-api, response-api, hatchet workers; all run in this
# container via turbo dev). The two workers + response-api also need
# HATCHET_CLIENT_TOKEN at boot — supplied at runtime from .hatchet.env. ---
# olat-api: bearer key gating its inbound REST API (dev value).
OLAT_API_KEY=abcd
# response-api: allow-list of browser Origins that POST live-quiz responses
# (the student PWA, via NEXT_PUBLIC_ADD_RESPONSE_URL above).
CORS_ALLOWED_ORIGINS=https://pwa.klicker.localhost

# --- Trust the local mkcert CA (mounted in docker-compose.yml) so any server-side
# HTTPS fetch to a *.klicker.localhost host verifies cleanly. (GOTCHAS #16) ---
NODE_EXTRA_CA_CERTS=/etc/devrouter/mkcert-rootCA.pem

# --- PHASE 2 Tier 2 (LTI) ---
APP_ORIGIN_LTI=https://lti.klicker.localhost
LTI_PORT=4000
LTI_DB_TYPE=postgres
LTI_DB_HOST=postgres
LTI_DB_PORT=5432
LTI_DB_USER=klicker-prod-lti
LTI_DB_PASS=klicker
LTI_DB_NAME=klicker-prod-lti
LTI_ENCRYPTION_KEY=abcdabcdabcdabcdabcdabcdabcdabcd
LTI_DEV_MODE=true

# --- PHASE 2 Tier 3 (Chat) ---
# NOTE: Set UPSTREAM_OPENAI_API_KEY in your local environment to enable chat
# (see .devcontainer/.secrets.env — gitignored, sourced by post-start.sh).
NEXT_PUBLIC_CHAT_URL=https://chat.klicker.localhost
APP_ORIGIN_CHAT=https://chat.klicker.localhost
OPENAI_BASE_URL=http://litellm:4000
DOC_QUERY_SCOPE_ISSUER=https://chat.klicker.localhost
DOC_QUERY_SCOPE_AUDIENCE=klicker-doc-query-dev
DOC_QUERY_SCOPE_KID=dev-unconfigured
# Manage MCP assistant (lecturer UI floating widget). Default-on in dev; the
# widget is gated off unless this is 'true'/'1'. Non-secret dev toggle.
NEXT_PUBLIC_MANAGE_ASSISTANT_ENABLED=true

# frame-ancestors CSP for the chat app (space-separated origins appended to
# 'self' by apps/chat/src/middleware.ts). Without it dev sends no
# frame-ancestors header at all, so any origin may frame the chat app —
# prod/stg set it via Helm (chat.allowedFrameAncestors). A CSP host wildcard
# matches nested subdomains, so this covers manage.klicker.localhost and the
# namespaced manage.klicker.<workspace>.localhost worktree hosts.
ALLOWED_FRAME_ANCESTORS=https://*.localhost

# Deliberate divergence from the deployed policy: production pins the primary
# model to gpt-5.5, while local dev pins Auto Mode as the primary selector so
# the complexity-router path gets exercised. The fallback (mini model) matches
# production and stays the credit-safe default.
CHAT_PRIMARY_MODEL_ID=auto
CHAT_FALLBACK_MODEL_ID=gpt-4.1-mini
