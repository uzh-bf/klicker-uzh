{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "API_DOMAIN",
    "APP_CONTROL_DOMAIN",
    "APP_CONTROL_SUBDOMAIN",
    "APP_LTI_DOMAIN",
    "APP_LTI_SUBDOMAIN",
    "APP_MANAGE_DOMAIN",
    "APP_MANAGE_SUBDOMAIN",
    "APP_STUDENT_DOMAIN",
    "APP_STUDENT_SUBDOMAIN",
    "APP_SECRET",
    "ASSESSMENT_AUDIT_PILOT_LIVE_QUIZ_IDS",
    "ASSESSMENT_AUDIT_ROLLOUT",
    "ASSESSMENT_AUDIT_BLOB_ENDPOINT",
    "ASSESSMENT_AUDIT_ENVIRONMENT",
    "ASSESSMENT_AUDIT_METRICS_PORT",
    "ASSESSMENT_AUDIT_TABLE_ENDPOINT",
    "ASSESSMENT_AUDIT_WORKER_ENABLED",
    "ASSESSMENT_AUDIT_WORKER_ROLE",
    "ASSESSMENT_MODE",
    "AUTH_LECTURER_ALLOWED_HOSTS",
    "AUTH_STUDENT_ALLOWED_HOSTS",
    "AZUREWEBJOBSFEATUREFLAGS",
    "AZUREWEBJOBSSTORAGE",
    "AZURE_TOKEN_CREDENTIALS",
    "BLOB_STORAGE_ACCESS_KEY",
    "BLOB_STORAGE_ACCOUNT_NAME",
    "COOKIE_DOMAIN",
    "CORS_ALLOWED_ORIGINS",
    "CRON_TOKEN",
    "DATABASE_IMPORT_USER",
    "DATABASE_URL",
    "EDUID_CLIENT_SECRET",
    "EDUID_FETCH_USERINFO",
    "EMAIL_TYPE",
    "EMAIL_HOST",
    "EMAIL_PORT",
    "EMAIL_SECURE",
    "EMAIL_USER",
    "EMAIL_PASS",
    "EMAIL_FROM",
    "FUNCTIONS_EXTENSION_VERSION",
    "FUNCTIONS_WORKER_PROCESS_COUNT",
    "FUNCTIONS_WORKER_RUNTIME",
    "GROWTHBOOK_API_HOST",
    "GROWTHBOOK_CLIENT_KEY",
    "GROWTHBOOK_ENV",
    "GROWTHBOOK_MANAGEMENT_API_KEY",
    "GROWTHBOOK_MANAGEMENT_API_URL",
    "HATCHET_CLIENT_TLS_STRATEGY",
    "HATCHET_CLIENT_HOST_PORT",
    "HATCHET_CLIENT_TOKEN",
    "HATCHET_HOST_PORT",
    "HATCHET_API_URL",
    "HATCHET_TENANT_ID",
    "HATCHET_LOG_LEVEL",
    "HATCHET_WORKER_NAME",
    "HATCHET_WORKFLOWS",
    "LTI_DB_TYPE",
    "LTI_DB_HOST",
    "LTI_DB_PORT",
    "LTI_DB_USER",
    "LTI_DB_PASS",
    "LTI_DB_NAME",
    "LTI_NAME",
    "LTI_URL",
    "LTI_AUTH_ENDPOINT",
    "LTI_TOKEN_ENDPOINT",
    "LTI_KEYS_ENDPOINT",
    "LTI_CLIENT_ID",
    "LTI_DB_CONNECTION_STRING",
    "LTI_ENCRYPTION_KEY",
    "LTI_PORT",
    "LTI_REDIRECT_URL",
    "LTI_DEV_MODE",
    "LTI_AAS_MODE",
    "NEXT_PUBLIC_ENV",
    "NEXT_PUBLIC_GROWTHBOOK_API_HOST",
    "NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY",
    "NODE_ENV",
    "NOTIFICATION_SECRET",
    "NOTIFICATION_SUPPORT_MAIL",
    "NOTIFICATION_URL",
    "OLAT_API_KEY",
    "PRISMA_OPTIMIZE",
    "REDIS_ASSESSMENT_HOST",
    "REDIS_ASSESSMENT_PORT",
    "REDIS_CACHE_HOST",
    "REDIS_CACHE_PASS",
    "REDIS_CACHE_PORT",
    "REDIS_CACHE_TLS",
    "REDIS_HOST",
    "REDIS_PASS",
    "REDIS_PORT",
    "REDIS_TLS",
    "REDIS_ASSESSMENT_HOST",
    "REDIS_ASSESSMENT_PASS",
    "REDIS_ASSESSMENT_PORT",
    "REDIS_ASSESSMENT_TLS",
    "SERVICE_BUS_CONNECTION_STRING",
    "SERVICE_BUS_QUEUE_NAME",
    "SHADOW_DATABASE_URL",
    "TEAMS_WEBHOOK_URL",
    "VAPID_PRIVATE_KEY",
    "VAPID_PUBLIC_KEY",
    "VAPID_PUBLIC_KEY_TEST",
    "APP_ORIGIN_AUTH",
    "APP_ORIGIN_API",
    "APP_ORIGIN_LTI",
    "APP_ORIGIN_PWA",
    "APP_ORIGIN_MANAGE",
    "APP_ORIGIN_CONTROL",
    "APP_ORIGIN_ASSESSMENT_API",
    "APP_ORIGIN_ASSESSMENT_PWA",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "CHAT_OPENAI_STORE_RESPONSES",
    "CHAT_ENABLE_AI_TELEMETRY",
    "CHAT_PRIMARY_MODEL_ID",
    "CHAT_FALLBACK_MODEL_ID",
    "CHAT_ACCOUNT_USAGE_ENFORCEMENT_ENABLED",
    "CHAT_TURN_LIFECYCLE_WRITES_ENABLED",
    "CHAT_MODEL_REGISTRY_JSON",
    "ALLOWED_FRAME_ANCESTORS",
    "BLOB_STORAGE_ACCOUNT_URL",
    "UPSTREAM_OPENAI_API_KEY",
    "UPSTREAM_OPENAI_BASE_URL",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL"
  ],
  "tasks": {
    "lint": {
      "outputLogs": "errors-only"
    },
    "check": {
      "cache": false,
      "outputLogs": "new-only",
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "out/**"]
    },
    "build:test": {
      "dependsOn": ["^build:test"],
      "outputs": ["dist/**", ".next/**", "build/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "dev:lti": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "dev:offline": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "dev:assessment": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "dev:docs": {
      "cache": false,
      "persistent": true
    },
    "dev:test": {
      "cache": false,
      "outputs": ["dist/**", ".next/**", "build/**", "out/**"],
      "persistent": true
    },
    "publish": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "start": {
      "dependsOn": ["^build", "build"],
      "outputs": ["dist/**", ".next/**", "build/**", "out/**"]
    },
    "start:test": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "cache": false
    }
  }
}
