meta {
  name: Repeat Idempotent Event (Same EventId)
  type: http
  seq: 5
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{INTERNAL_TOKEN}}
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "student:bob.wilson@uzh.ch",
    "action": "answer.submitted",
    "eventId": "answer-submission-unique-001",
    "resourceId": "question-42",
    "sessionId": "live-session-xyz",
    "userId": "student-789",
    "attributes": {
      "questionType": "multiple-choice",
      "answerValue": "B",
      "timeSpent": 23,
      "confident": true,
      "submissionAttempt": 1
    }
  }
}

assert {
  res.status: 202
  res.body.status: eq accepted
  res.body.eventId: eq answer-submission-unique-001
}

tests {
  test("Repeat submission returns same status", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
  test("Same eventId is returned", function() {
    const body = res.getBody();
    expect(body.eventId).to.equal("answer-submission-unique-001");
  });
  
  test("Idempotent behavior confirmed", function() {
    const body = res.getBody();
    expect(body.status).to.equal('accepted');
    // In a complete implementation, we'd verify timestamp and other details match
  });
  
  test("No duplicate event created", function() {
    // This test verifies the service handles duplicate eventIds correctly
    // The exact same response should be returned
    expect(res.getStatus()).to.equal(202);
  });
}

script:post-response {
  if (res.body && res.body.eventId) {
    console.log("Repeat idempotent event processed with same ID:", res.body.eventId);
    
    // Compare with original response (in real implementation)
    const originalEventId = bru.getVar("idempotentEventId");
    if (originalEventId === res.body.eventId) {
      console.log("✅ Idempotency verified - same eventId returned");
    } else {
      console.log("❌ Idempotency issue - different eventId returned");
    }
  }
}

docs {
  Test idempotent behavior by repeating exact same request.
  
  This test should be run AFTER the idempotent.bru test to verify:
  - Same eventId produces identical response
  - No duplicate events are created in storage
  - Response time is consistent (cached vs. new)
  - All response fields match the original
  
  Idempotency is critical for:
  - Client retry safety
  - Network failure recovery
  - Batch job reliability
  - Exactly-once processing semantics
  
  Expected: Identical response to first submission with same eventId.
}