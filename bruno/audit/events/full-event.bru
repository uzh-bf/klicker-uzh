meta {
  name: Full Audit Event
  type: http
  seq: 2
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{INTERNAL_TOKEN}}
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "instructor:{{USER_EMAIL}}",
    "action": "quiz.created",
    "resourceId": "quiz-{{$randomUUID}}",
    "sessionId": "session-{{$timestamp}}",
    "userId": "{{USER_ID}}",
    "attributes": {
      "quizName": "Final Exam - Introduction to Computer Science",
      "questionCount": 25,
      "timeLimit": 90,
      "tags": ["exam", "cs101", "final"],
      "settings": {
        "randomizeQuestions": true,
        "showCorrectAnswers": false,
        "allowRetakes": false
      },
      "metadata": {
        "courseId": "{{COURSE_ID}}",
        "semester": "HS2024",
        "department": "Computer Science"
      }
    }
  }
}

assert {
  res.status: 202
  res.body.status: eq accepted
  res.body.eventId: isString
  res.responseTime: < 5000
}

tests {
  test("Full event is accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
  test("Response preserves all provided data", function() {
    const body = res.getBody();
    expect(body.eventId).to.be.a('string');
    expect(body.status).to.equal('accepted');
  });
  
  test("Complex attributes are handled correctly", function() {
    // Since we can't inspect storage directly, we verify the request was accepted
    // Integration tests would verify the data was stored correctly
    expect(res.getStatus()).to.equal(202);
  });
}

script:post-response {
  if (res.body && res.body.eventId) {
    bru.setVar("fullEventId", res.body.eventId);
    bru.setVar("lastQuizId", req.body.resourceId);
    console.log("Full event created with ID:", res.body.eventId);
    console.log("Quiz ID:", req.body.resourceId);
  }
}

docs {
  Test comprehensive audit event with all available fields.
  
  All fields provided:
  - tenantId, subject, action (required)
  - resourceId: The specific resource affected
  - sessionId: Current user/system session
  - userId: Authenticated user identifier
  - attributes: Rich metadata object with nested data
  
  Expected behavior:
  - HTTP 202 Accepted status
  - All data preserved in storage
  - Complex nested attributes handled correctly
  - Event available for querying and analysis
}