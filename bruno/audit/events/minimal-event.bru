meta {
  name: Minimal Audit Event
  type: http
  seq: 1
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{INTERNAL_TOKEN}}
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "user:{{USER_EMAIL}}",
    "action": "session.started"
  }
}

assert {
  res.status: 202
  res.body.status: eq accepted
  res.body.eventId: isString
  res.responseTime: < 5000
}

tests {
  test("Minimal event is accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
  test("Response contains generated event ID", function() {
    const body = res.getBody();
    expect(body.eventId).to.be.a('string');
    expect(body.eventId).to.have.length.greaterThan(10); // UUIDs are longer
  });
  
  test("Response indicates accepted status", function() {
    const body = res.getBody();
    expect(body.status).to.equal('accepted');
  });
  
  test("Auto-generated timestamp should be recent", function() {
    const body = res.getBody();
    if (body.timestamp) {
      const eventTime = new Date(body.timestamp);
      const now = new Date();
      const diffMinutes = (now - eventTime) / (1000 * 60);
      expect(diffMinutes).to.be.below(5); // Event should be within 5 minutes
    }
  });
}

script:post-response {
  if (res.body && res.body.eventId) {
    bru.setVar("minimalEventId", res.body.eventId);
    console.log("Minimal event created with ID:", res.body.eventId);
  }
}

docs {
  Test minimal audit event with only required fields.
  
  Required fields only:
  - tenantId: Identifies the tenant/organization
  - subject: Who/what performed the action
  - action: What action was performed
  
  Expected behavior:
  - HTTP 202 Accepted status
  - Auto-generated eventId (UUID format)
  - Auto-generated timestamp (current time)
  - Event stored in Azure Table Storage
}