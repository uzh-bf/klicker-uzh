meta {
  name: Delete Operation Event
  type: http
  seq: 6
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{AUDIT_TOKEN}}
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "admin:carol.johnson@uzh.ch",
    "action": "course.deleted",
    "resourceId": "course-{{COURSE_ID}}-{{$timestamp}}",
    "userId": "admin-123",
    "attributes": {
      "courseName": "Introduction to Computer Science",
      "courseCode": "{{COURSE_ID}}",
      "studentCount": 120,
      "reason": "course-restructuring",
      "backupCreated": true,
      "deletedBy": "admin",
      "approvalRequired": true,
      "retentionPeriod": "7-years",
      "archiveLocation": "azure-cold-storage"
    }
  }
}

assert {
  res.status: 202
  res.body.status: eq accepted
  res.body.eventId: isString
}

tests {
  test("Delete operation is logged successfully", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("Critical delete operation has detailed audit trail", function() {
    const body = res.getBody();
    expect(body.eventId).to.be.a('string');
    expect(body.status).to.equal('accepted');
  });

  test("Compliance data is captured", function() {
    // Verify the operation includes compliance-relevant metadata
    expect(res.getStatus()).to.equal(202);
  });
}

script:post-response {
  if (res.body && res.body.eventId) {
    bru.setVar("deleteOperationEventId", res.body.eventId);
    console.log("Delete operation logged with ID:", res.body.eventId);
    console.log("Resource deleted:", req.body.resourceId);
  }
}

docs {
  Test audit logging for high-risk delete operations.

  Delete operations require comprehensive audit trails for:
  - Compliance and regulatory requirements
  - Data governance and retention policies
  - Security incident investigation
  - Accidental deletion recovery
  - Administrative oversight

  Key attributes for delete events:
  - Who performed the deletion (subject, userId)
  - What was deleted (resourceId, courseName)
  - Why it was deleted (reason)
  - Safeguards taken (backupCreated)
  - Compliance measures (retentionPeriod, archiveLocation)

  This supports audit requirements for educational data management.
}
