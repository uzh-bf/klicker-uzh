meta {
  name: Valid Authentication Token
  type: http
  seq: 3
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{AUDIT_TOKEN}}
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "user:test-auth",
    "action": "auth.test.success"
  }
}

assert {
  res.status: 202
  res.body.status: eq accepted
  res.body.eventId: isString
  res.responseTime: < 5000
}

tests {
  test("Request with valid token is accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("Response contains event ID", function() {
    const body = res.getBody();
    expect(body.eventId).to.be.a('string');
    expect(body.eventId).to.have.length.greaterThan(0);
  });

  test("Response indicates accepted status", function() {
    const body = res.getBody();
    expect(body.status).to.equal('accepted');
  });
}

script:post-response {
  // Store the event ID for potential use in other tests
  if (res.body && res.body.eventId) {
    bru.setVar("lastAuthEventId", res.body.eventId);
    console.log("Auth test event created with ID:", res.body.eventId);
  }
}

docs {
  Test successful authentication with valid internal token.

  Expected behavior:
  - HTTP 202 Accepted status
  - Response with eventId and status: 'accepted'
  - Audit event successfully created in storage
  - Response time under 5 seconds

  This validates the happy path for internal service authentication.
}
