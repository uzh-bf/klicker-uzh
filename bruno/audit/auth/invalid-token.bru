meta {
  name: Invalid Authentication Token
  type: http
  seq: 2
}

post {
  url: {{AUDIT_URL}}/audit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: invalid-wrong-token-123
}

body:json {
  {
    "tenantId": "{{TENANT_ID}}",
    "subject": "user:test",
    "action": "test.action"
  }
}

assert {
  res.status: 401
  res.body.error: contains unauthorized
}

tests {
  test("Request with invalid token is rejected", function() {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("Error message indicates invalid token", function() {
    const body = res.getBody();
    expect(body.error || body.message).to.match(/unauthorized|invalid.*token|auth/i);
  });
}

docs {
  Test authentication validation - requests with invalid tokens should be rejected.
  
  Expected behavior:
  - HTTP 401 Unauthorized status
  - Error message indicating invalid authentication
  - No audit event should be created
  
  This validates that only legitimate internal services can create audit events.
}