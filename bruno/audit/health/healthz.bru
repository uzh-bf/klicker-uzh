meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{AUDIT_URL}}/healthz
  body: none
  auth: none
}

assert {
  res.status: 200
  res.responseTime: < 1000
}

tests {
  test("Health check returns OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function() {
    expect(res.getResponseTime()).to.be.below(1000);
  });
}

docs {
  Basic health check endpoint to verify the audit service is running.
  
  This endpoint should:
  - Return 200 OK when service is healthy
  - Respond quickly (< 1 second)
  - Be available even during maintenance
  
  Used by load balancers and monitoring systems.
}