meta {
  name: Prometheus Metrics
  type: http
  seq: 3
}

get {
  url: {{AUDIT_URL}}/metrics
  body: none
  auth: none
}

assert {
  res.status: 200
  res.responseTime: < 3000
  res.headers.content-type: contains text/plain
}

tests {
  test("Metrics endpoint returns OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains Prometheus metrics", function() {
    expect(res.getHeader("content-type")).to.contain("text/plain");
    expect(res.getBody()).to.contain("# HELP");
    expect(res.getBody()).to.contain("# TYPE");
  });
  
  test("Contains audit-specific metrics", function() {
    const body = res.getBody();
    expect(body).to.match(/audit_events_total|audit_requests_total/);
  });
}

script:post-response {
  // Extract key metrics for monitoring
  const body = res.getBody();
  const metrics = {};
  
  // Parse basic counter metrics
  const lines = body.split('\n');
  lines.forEach(line => {
    if (line.startsWith('audit_events_total')) {
      const match = line.match(/audit_events_total\{.*\}\s+(\d+)/);
      if (match) {
        bru.setVar("audit_events_total", match[1]);
      }
    }
  });
  
  console.log("Current audit events processed:", bru.getVar("audit_events_total") || "unknown");
}

docs {
  Prometheus metrics endpoint for monitoring and alerting.
  
  This endpoint should provide metrics including:
  - audit_events_total: Total number of audit events processed
  - audit_requests_total: Total HTTP requests received  
  - audit_errors_total: Total number of processing errors
  - audit_request_duration_seconds: Request processing time histogram
  
  Used by Prometheus monitoring system for dashboards and alerts.
}