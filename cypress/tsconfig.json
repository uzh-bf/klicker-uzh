{
  "include": ["cypress.config.ts", "**/*.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["es2022", "dom"],
    "types": [
      "cypress",
      "node",
      "@testing-library/cypress",
      "cypress-real-events"
    ]
  }
}
