{
  "name": "@klicker-uzh/hatchet",
  "version": "3.3.0-alpha.82",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.9.4",
    "@klicker-uzh/prisma": "workspace:*",
    "@klicker-uzh/types": "workspace:*"
  },
  "devDependencies": {
    "@parcel/watcher": "~2.4.1",
    "@types/node": "^24.10.1",
    "cross-env": "~7.0.3",
    "graphql-yoga": "~3.9.1",
    "ioredis": "~5.4.1",
    "npm-run-all": "~4.1.5",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "run-s --npm-path pnpm build:clean build:ts",
    "build:clean": "rm -rf dist",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production tsc -p tsconfig.json",
    "check": "tsc --noEmit --tsBuildInfoFile dist/tsconfig.check.tsbuildinfo",
    "dev": "run-p --npm-path pnpm dev:ts",
    "dev:infisical": "../../util/_run_with_infisical.sh --env dev pnpm run dev",
    "dev:offline": "pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
