  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "1.9.4",
    "@klicker-uzh/analytics-engine-contract": "workspace:*",
    "@klicker-uzh/prisma": "workspace:*",
    "@klicker-uzh/types": "workspace:*"
  },
  "devDependencies": {
    "@parcel/watcher": "~2.4.1",
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^24.10.1",
    "cross-env": "~7.0.3",
    "graphql-yoga": "~3.9.1",
    "ioredis": "~5.4.1",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "rollup-plugin-copy": "~3.5.0",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "run-s --npm-path pnpm build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit --tsBuildInfoFile dist/tsconfig.check.tsbuildinfo",
    "dev": "run-p --npm-path pnpm dev:ts",
    "dev:infisical": "../../util/_run_with_infisical.sh --env dev pnpm run dev",
    "dev:offline": "pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
