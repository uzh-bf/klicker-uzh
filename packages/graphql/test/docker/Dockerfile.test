FROM node:20

# Install dependencies
RUN npm install -g pnpm

WORKDIR /app

# Create database initialization script
RUN echo '#!/bin/bash\n\
  set -e\n\
  \n\
  echo "Running tests from container..."\n\
  \n\
  cd /usr/src/app\n\
  \n\
  # Verify PostgreSQL connection
  echo "Checking PostgreSQL connection..."\n\
  if pg_isready -h postgres -U postgres; then\n\
  echo "PostgreSQL is ready!"\n\
  else\n\
  echo "PostgreSQL is not ready. Exiting."\n\
  exit 1\n\
  fi\n\
  \n\
  # Verify Hatchet token is available
  if [ -f "/hatchet/env/token.env" ]; then\n\
  echo "Hatchet token found!"\n\
  else\n\
  echo "Hatchet token not found. Exiting."\n\
  exit 1\n\
  fi\n\
