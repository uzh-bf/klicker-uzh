FROM node:20

# Install dependencies
RUN npm install -g pnpm

WORKDIR /app

# Create database initialization script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "Running tests from container..."\n\
\n\
cd /usr/src/app\n\
\n\
# Ensure PostgreSQL is ready\n\
echo "Waiting for PostgreSQL to be ready..."\n\
for i in {1..10}; do\n\
  echo "Attempt $i to connect to PostgreSQL..."\n\
  if pg_isready -h postgres -U postgres; then\n\
    echo "PostgreSQL is ready!"\n\
    break\n\
  fi\n\
  if [ "$i" = "10" ]; then\n\
    echo "PostgreSQL failed to become ready. Exiting."\n\
    exit 1\n\
  fi\n\
  echo "Waiting..."\n\
  sleep 2\n\
done\n\
\n\
# Setup Prisma\n\
echo "Setting up Prisma..."\n\
cd /usr/src/app/packages/prisma\n\
echo "Current directory: $(pwd)"\n\
\n\
# Build the prisma package first\n\
echo "Building prisma package..."\n\
pnpm run build\n\
\n\
# Run migrations using the prisma CLI commands configured for this project\n\
echo "Running migrations..."\n\
pnpm run prisma:reset:raw -f\n\
\n\
# Run tests\n\
echo "Running tests..."\n\
cd /usr/src/app/packages/graphql\n\
DATABASE_URL=$DATABASE_URL pnpm jest --verbose\n\
\n\
TEST_EXIT=$?\n\
echo "Tests completed with exit code: $TEST_EXIT"\n\
exit $TEST_EXIT\n\
' > /app/run-tests.sh

# Make the script executable
RUN chmod +x /app/run-tests.sh

# Install PostgreSQL client and dependencies
RUN apt-get update && \
    apt-get install -y postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# Set the command to run the script
CMD ["/app/run-tests.sh"]
