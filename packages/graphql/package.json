    "@klicker-uzh/prisma": "workspace:*",
    "@klicker-uzh/types": "workspace:*",
    "@klicker-uzh/util": "workspace:*",
    "@pothos/core": "4.3.0",
    "@pothos/plugin-directives": "4.1.0",
    "@pothos/plugin-prisma": "4.10.0",
    "@pothos/plugin-scope-auth": "4.1.6",
    "@pothos/plugin-zod": "4.1.0",
    "axios": "1.16.1",
    "bcryptjs": "2.4.3",
    "dayjs": "1.11.20",
    "generate-password": "1.7.1",
    "graphql": "16.11.0",
    "graphql-scalars": "1.23.0",
    "graphql-yoga": "3.9.1",
    "ioredis": "5.4.1",
    "mathjs": "11.9.1",
    "node-schedule": "2.1.1",
    "nodemailer": "6.9.15",
    "remeda": "2.15.0",
    "unique-names-generator": "4.7.1",
    "uuid": "10.0.0",
    "validator": "13.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "~5.0.3",
    "@graphql-codegen/fragment-matcher": "~5.0.2",
    "@graphql-codegen/schema-ast": "~4.1.0",
    "@graphql-codegen/typed-document-node": "~5.0.10",
    "@graphql-codegen/typescript": "~4.1.0",
    "@graphql-codegen/typescript-operations": "~4.3.0",
    "@graphql-codegen/typescript-resolvers": "~4.3.0",
    "@graphql-tools/utils": "~10.5.5",
    "@graphql-typed-document-node/core": "~3.2.0",
    "@istanbuljs/nyc-config-typescript": "~1.0.2",
    "@klicker-uzh/hatchet": "workspace:*",
    "@parcel/watcher": "~2.4.1",
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/node-schedule": "^2.1.7",
    "@types/nodemailer": "^6.4.23",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.3",
    "cli-progress": "~3.12.0",
    "cross-env": "~7.0.3",
    "csv-parse": "~6.1.0",
    "dotenv": "~16.4.7",
    "eslint": "~9.30.1",
    "graphql-codegen-persisted-query-ids": "~0.2.0",
    "nodemon": "~3.1.14",
    "npm-run-all": "~4.1.5",
    "nyc": "~17.1.0",
    "rollup": "~4.34.9",
    "rollup-plugin-copy": "~3.5.0",
    "ts-node": "~10.9.2",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4",
    "web-push": "~3.6.7"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production run-s --npm-path pnpm generate build:ts",
    "build:instrument": "nyc instrument --compact=false src instrumented",
    "build:test": "run-s --npm-path pnpm build:instrument build",
    "build:ts": "rollup -c",
    "check": "run-s --npm-path pnpm generate check:schema check:ts",
    "check:schema": "git diff --exit-code -- src/public/schema.graphql",
    "check:ts": "tsc --noEmit -p tsconfig.check.json",
    "dev": "run-s --npm-path pnpm generate dev:parallel",
    "dev:graphql": "nodemon --watch 'src/graphql/ops/*.graphql' --watch 'src/**/*.ts' --exec 'pnpm generate'",
    "dev:infisical": "../../util/_run_with_infisical.sh --env dev pnpm run dev",
    "dev:offline": "pnpm run dev",
    "dev:parallel": "npm-run-all --parallel dev:graphql dev:ts",
    "dev:test": "pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "generate": "graphql-codegen --config codegen.ts && node scripts/merge-persisted-query-compatibility.mjs",
    "pretest": "pnpm run generate",
    "pretest:watch": "pnpm run generate",
    "script": "../../util/_run_with_infisical.sh --env dev tsx --env-file=.env",
    "script:invitations:dev": "CONFIG=dev ../../util/_run_with_infisical.sh --env dev tsx src/scripts/importParticipantInvitations.ts",
    "script:invitations:prd": "CONFIG=prd ../../util/_run_with_infisical.sh --env prd tsx src/scripts/importParticipantInvitations.ts",
    "script:invitations:stg": "CONFIG=stg ../../util/_run_with_infisical.sh --env stg tsx src/scripts/importParticipantInvitations.ts",
    "script:prod": "NODE_ENV=production ../../util/_run_with_infisical.sh --env prd tsx",
    "script:stg": "NODE_ENV=stg ../../util/_run_with_infisical.sh --env stg tsx",
    "test": "vitest run",
    "test:local": "bash ./test/run-tests-local.sh",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
