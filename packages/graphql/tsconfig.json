{
  "include": ["./**/*"],
  "exclude": ["node_modules", "dist", "src/scripts", "instrumented/"],
  "compilerOptions": {
    "rootDir": ".",
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* If transpiling with TypeScript: */
    "module": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    /* AND if you're building for a library: */
    "declaration": true,
    /* Incremental build cache: */
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declarationMap": true,
    /* If your code doesn't run in the DOM: */
    "lib": ["es2022"],
    "noErrorTruncation": true,
    // "preserveSymlinks": true
    "paths": {
      "@/*": ["./src/*"],
      "@klicker-uzh/adaptive-test-host/schema": ["./src/index.ts"],
      "@klicker-uzh/adaptive-test-host/helpers": ["./test/helpers.ts"],
      "@klicker-uzh/adaptive-test-host/services/*": ["./src/services/*.ts"]
    },
    /* Vitest global types */
    "types": ["vitest/globals"]
  }
}
