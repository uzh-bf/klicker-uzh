enum ByokCapabilityStatus {
  RESERVED
  ISSUED
  CONSUMED
  EXPIRED
  CANCELLED
}

enum ProviderCredentialStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  REVOKED
  DELETION_PENDING
  DELETED
}

enum ProviderNoticeAcknowledgementSource {
  CHAT_FIRST_USE
}

enum CreditResetPeriod {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  NONE
}

enum ChatAttachmentType {
  IMAGE
}

enum ChatMessageRating {
  UP
  DOWN
}

model ChatUsageCredits {
  total   Decimal @default(0) @db.Decimal(18, 6)
  current Decimal @default(0) @db.Decimal(18, 6)

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  // Reset tracking fields
  periodStartedAt DateTime? // When current credit period began
  lastResetAt     DateTime? // Last time credits were reset
  resetCount      Int       @default(0) // Number of resets performed

  // Disclaimer tracking fields
  acceptedDisclaimerId String?   @db.Uuid // ID of accepted disclaimer version
  disclaimerAcceptedAt DateTime? // When disclaimer was accepted
  disclaimerDeclined   Boolean   @default(false) // Whether disclaimer was declined

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([participantId, chatbotId])
}

model ChatThread {
  id    String  @id @default(uuid()) @db.Uuid
  title String?

  messages ChatMessage[]

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id               String             @id @default(uuid()) @db.Uuid
  threadId         String             @db.Uuid
  parentId         String?            @db.Uuid
  role             String // 'user' | 'assistant'
  content          Json // Array<{ type: string; text: string }>
  chatMode         String?
  modelId          String?
  reasoningEffort  String?
  reasoningContent String?            @db.Text
  creditsUsed      Decimal?           @db.Decimal(18, 6)
  // Participant feedback on an assistant answer; null until they vote.
  rating           ChatMessageRating?

  attachments ChatAttachment[]

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([parentId])
}

model ChatAttachment {
  id String @id @default(uuid()) @db.Uuid

  type               ChatAttachmentType
  position           Int
  imageBase64        String?            @db.Text // base64 data URL for display 
  imagePreviewBase64 String?            @db.Text // compact preview data URL for history rendering
  imageDescription   String?            @db.Text // AI-generated description for context injection

  messageId String      @db.Uuid
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId, position])
}

model Chatbot {
  id String @id @default(uuid()) @db.Uuid

  name        String
  description String?
  avatar      String? // URL to avatar image

  // System prompts for different chat modes
  // TODO: add JSON types
  systemPrompts Json? // { tutor: {prompt: string; description: string}; explainer: {prompt: string; description: string}; ... }

  // Credit configuration per chatbot
  creditInitialCredits Int               @default(1)
  creditResetPeriod    CreditResetPeriod @default(WEEKLY)
  creditResetAmount    Int               @default(1)
  creditMaxCredits     Int               @default(1)

  // Model selection control
  modelSelection                 Boolean  @default(false) // Whether users can select models (false = automatic selection)
  allowedModelIds                String[] @default([]) // Restrict to these registry model IDs (empty = all models)
  allowedReasoningEffortsByModel Json? // { [modelId: string]: ReasoningEffort[] } where missing key = all supported efforts

  // OpenAI-compatible Configuration
  openaiApiKey  String? @db.Text // Encrypted API key using APP_SECRET
  openaiBaseUrl String? // Optional custom endpoint (defaults to model config)

  // Disclaimer configuration
  disclaimer   ChatbotDisclaimer? @relation(fields: [disclaimerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  disclaimerId String?            @db.Uuid

  // Relations
  mcpConfigurations ChatbotMCPConfig[]
  threads           ChatThread[]
  usageCredits      ChatUsageCredits[]
  providerBindings  ChatbotProviderBinding[]

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId String @db.Uuid

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatbotMCPServer {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique // e.g., "RAG_MCP", "Python_Executor", "R_Executor"
  description String?
  url         String // MCP server URL
  authType    String // 'bearer' | 'basic' | 'none' | 'custom'
  authSecret  String? @db.Text // Encrypted using APP_SECRET

  passChatbotId   Boolean @default(false) // Whether to include chatbot ID as header
  chatbotIdHeader String? // Header name for chatbot ID (default: 'Chatbot-ID')

  // Global parameters for this MCP server
  parameters Json? // Additional configuration parameters
  isActive   Boolean @default(true)

  // Relations
  configurations ChatbotMCPConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatbotMCPConfig {
  id String @id @default(uuid()) @db.Uuid

  // Relations
  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  chatbotId String  @db.Uuid

  mcpServer   ChatbotMCPServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  mcpServerId String           @db.Uuid

  // Configuration per chatbot-mode-mcp combination
  chatMode     String // 'tutor' | 'explainer' | 'default'
  allowedTools Json? // Array of allowed tool names/patterns (supports wildcards)
  priority     Int     @default(0) // Order of MCP servers (lower = higher priority)
  isEnabled    Boolean @default(true)

  // Chatbot-specific parameters that override server defaults
  parameters Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatbotId, mcpServerId, chatMode])
  @@index([chatbotId, chatMode])
}

model ChatbotDisclaimer {
  id String @id @default(uuid()) @db.Uuid

  name        String // Descriptive name for the disclaimer
  description String? // Optional description for management purposes

  title     String // Title shown in modal
  introText String? @db.Text // Customizable introduction text (course-specific)
  mediaUrl  String? // Optional video/image URL
  mediaType String? // 'video' | 'image'

  chatbots Chatbot[] // Chatbots using this disclaimer

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id      String @id @default(uuid()) @db.Uuid
  key     String @unique // Stable platform key, e.g. 'uzh-azure-openai'
  version Int    @default(1)

  providerKind        String // e.g. 'azure_openai' | 'openai' | 'openrouter'
  endpointAlias       String // Fixed gateway-side endpoint alias, never user-supplied
  deploymentAliases   String[] // Approved model deployment aliases for this profile
  autoManifestVersion String? // Set only when the profile's complete Auto manifest is published

  pricingSource String // Model cost map reference used for estimates
  currency      String @db.Char(3) // ISO 4217 currency for estimated costs
  dataBoundary  Json? // Factual data-processing boundary fields shown in the notice
  noticeVersion Int    @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials ProviderCredential[]

  @@index([isActive])
}

model ProviderCredential {
  id String @id @default(uuid()) @db.Uuid

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId String @db.Uuid

  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profileId String          @db.Uuid

  // Vault custody lives behind the AI Credential Gateway; product state stores
  // only the opaque handle facts.
  vaultSecretName    String
  vaultSecretVersion Int
  safeFingerprint    String? // Truncated display fingerprint, never the secret material

  status              ProviderCredentialStatus @default(PENDING_VALIDATION)
  validatedModelAlias String? // Named-model capability proven by validation
  validatedAt         DateTime?

  bindings      ChatbotProviderBinding[]
  usageAccounts ByokUsageAccount[]
  outboxEvents ProviderCredentialOutbox[]
  capabilities  ByokCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([profileId, status])
}

model ChatbotProviderBinding {
  id String @id @default(uuid()) @db.Uuid

  credential   ProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credentialId String             @db.Uuid

  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotId String  @db.Uuid

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId String @db.Uuid

  allowedModelAlias String // Named model from the profile's approved aliases
  isActive          Boolean @default(false)

  participantQuotaLimit Decimal @db.Decimal(18, 6)
  aggregateQuotaLimit   Decimal @db.Decimal(18, 6)

  currentNoticeVersion Int @default(1)

  acknowledgements  ProviderNoticeAcknowledgement[]
  traceDeletionJobs TraceDeletionJob[]
  usageAccounts     ByokUsageAccount[]
  capabilities      ByokCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatbotId, credentialId])
  @@index([chatbotId, isActive])
}

model ProviderNoticeAcknowledgement {
  id String @id @default(uuid()) @db.Uuid

  binding   ChatbotProviderBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bindingId String                 @db.Uuid

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantId String      @db.Uuid

  noticeVersion Int
  source        ProviderNoticeAcknowledgementSource

  acknowledgedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([participantId, bindingId, noticeVersion])
}

model ByokUsageAccount {
  id String @id @default(uuid()) @db.Uuid

  credential   ProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credentialId String             @db.Uuid

  binding   ChatbotProviderBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bindingId String?                 @db.Uuid

  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  participantId String?      @db.Uuid

  reservedAmount Decimal @default(0) @db.Decimal(18, 6)
  usedAmount     Decimal @default(0) @db.Decimal(18, 6)
  currency       String  @db.Char(3)

  settledAt DateTime?
  isSettled Boolean   @default(false)

  requestTraceId String? // Langfuse/OTel trace id for deletion selection

  capability ByokCapability?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialId, isSettled])
  @@index([participantId])
}

model ByokCapability {
  id String @id @default(uuid()) @db.Uuid

  status ByokCapabilityStatus @default(RESERVED)

  // Full authorization scope stored server-side; never returned to callers.
  ownerId            String @db.Uuid
  chatbotId          String @db.Uuid
  profileKey         String
  allowedModelAlias  String
  vaultSecretVersion Int

  // Only the SHA-256 hash of the opaque bearer is persisted. The raw token
  // is returned exactly once at issue time and never stored or logged.
  bearerHash String @unique

  expiresAt  DateTime
  consumedAt DateTime?

  credential   ProviderCredential     @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credentialId String                 @db.Uuid
  binding      ChatbotProviderBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bindingId    String                 @db.Uuid
  usageAccount ByokUsageAccount       @relation(fields: [usageAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  usageAccountId String               @db.Uuid @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([ownerId])
}

model TraceDeletionJob {
  id String @id @default(uuid()) @db.Uuid

  binding   ChatbotProviderBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bindingId String?                 @db.Uuid

  tombstonedUserId    String? @db.Uuid
  tombstonedChatbotId String? @db.Uuid

  traceSelectors Json // Trace ids and selectors to delete; never payload copies

  requestedAt   DateTime?
  verifiedAt    DateTime?
  attempts      Int       @default(0)
  terminalState String    @default("PENDING") // PENDING | REQUESTED | VERIFIED | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([terminalState])
}

model ProviderCredentialOutbox {
  id String @id @default(uuid()) @db.Uuid

  credential ProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  credentialId String @db.Uuid

  // Durable lifecycle events for gateway sync; payloads carry safe metadata
  // only (status, vault handle facts, binding state). No secret material.
  eventType String
  payload Json

  processedAt DateTime?
  attempts Int @default(0)
  terminalState String @default("PENDING") // PENDING | PROCESSED | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([credentialId, terminalState])
  @@index([terminalState])
}
