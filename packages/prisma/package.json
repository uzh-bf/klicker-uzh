{
  "name": "@klicker-uzh/prisma",
  "version": "3.4.0-alpha.71",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@pothos/plugin-prisma": "~4.10.0",
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/pg": "^8.15.5",
    "cross-env": "~7.0.3",
    "eslint": "~9.30.1",
    "npm-run-all": "~4.1.5",
    "prisma": "7.8.0",
    "prisma-json-types-generator": "5.1.0",
    "rollup": "~4.34.9",
    "rollup-plugin-copy": "~3.5.0",
    "rollup-plugin-delete": "~2.1.0",
    "tsx": "~4.19.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "run-s --npm-path pnpm generate build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "run-s --npm-path pnpm generate check:ts",
    "check:ts": "tsc --noEmit -p tsconfig.check.json",
    "generate": "prisma generate",
    "prisma:deploy": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:deploy:raw",
    "prisma:deploy:prod": "../../util/_run_with_infisical.sh --env prd pnpm run prisma:deploy:raw",
    "prisma:deploy:qa": "../../util/_run_with_infisical.sh --env stg pnpm run prisma:deploy:raw",
    "prisma:deploy:raw": "prisma migrate deploy",
    "prisma:diff": "../../util/_run_with_infisical.sh --env prd env SHADOW_DATABASE_URL=postgres://klicker-prod:klicker@localhost:5432/shadow pnpm run prisma:diff:raw",
    "prisma:diff:raw": "prisma migrate diff --from-config-datasource --to-migrations src/prisma/schema/migrations",
    "prisma:migrate": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:migrate:raw",
    "prisma:migrate:create": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:migrate:create:raw",
    "prisma:migrate:create:only": "prisma migrate dev --create-only",
    "prisma:migrate:create:raw": "run-s --npm-path pnpm \"prisma:migrate:create:only {@}\" generate --",
    "prisma:migrate:only": "prisma migrate dev",
    "prisma:migrate:raw": "run-s --npm-path pnpm \"prisma:migrate:only {@}\" generate --",
    "prisma:push": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:push:raw",
    "prisma:push:only": "prisma db push",
    "prisma:push:qa": "../../util/_run_with_infisical.sh --env stg pnpm run prisma:push:raw",
    "prisma:push:raw": "run-s --npm-path pnpm \"prisma:push:only {@}\" generate --",
    "prisma:reset": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:reset:raw",
    "prisma:reset:qa": "../../util/_run_with_infisical.sh --env stg pnpm run prisma:reset:raw",
    "prisma:reset:raw": "prisma migrate reset",
    "prisma:reset:seed": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:reset:seed:raw",
    "prisma:reset:seed:raw": "run-s --npm-path pnpm \"prisma:reset:raw {@}\" prisma:seed:raw --",
    "prisma:reset:yes": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:reset:raw -f",
    "prisma:resolve:prod": "../../util/_run_with_infisical.sh --env prd prisma migrate resolve",
    "prisma:resolve:qa": "../../util/_run_with_infisical.sh --env stg prisma migrate resolve",
    "prisma:seed": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:seed:raw",
    "prisma:seed:raw": "prisma db seed",
    "prisma:setup": "run-s --npm-path pnpm prisma:reset prisma:push",
    "prisma:setup:raw": "run-s --npm-path pnpm prisma:reset:raw prisma:push:raw",
    "prisma:setup:yes": "run-s --npm-path pnpm prisma:reset:yes prisma:push",
    "prisma:studio": "../../util/_run_with_infisical.sh --env dev pnpm run prisma:studio:raw",
    "prisma:studio:prod": "../../util/_run_with_infisical.sh --env prd pnpm run prisma:studio:raw",
    "prisma:studio:qa": "../../util/_run_with_infisical.sh --env stg pnpm run prisma:studio:raw",
    "prisma:studio:raw": "prisma studio"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "type": "module"
}
