    "@uzh-bf/design-system": "4.0.0-alpha.4",
    "next": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.5.4",
    "yup": "^1.4.0"
  },
  "scripts": {
    "build": "run-s build:tw build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "build:tw": "npx @tailwindcss/cli  -i src/tailwind.css -o src/public/styles.css",
    "check": "tsc --noEmit",
    "dev": "run-p dev:tw dev:ts",
    "dev:doppler": "doppler run --config dev -- pnpm run dev",
    "dev:offline": "pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "dev:tw": "npx @tailwindcss/cli  -w -i src/tailwind.css -o src/public/styles.css"
  },
  "engines": {
    "node": "=20"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "type": "module"
}
