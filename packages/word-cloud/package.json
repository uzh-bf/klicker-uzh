{
  "name": "@klicker-uzh/word-cloud",
  "version": "3.4.0-alpha.40",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1"
  },
  "devDependencies": {
    "@klicker-uzh/build-config": "workspace:*",
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^24.10.1",
    "cross-env": "~7.0.3",
    "eslint": "~9.30.1",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "run-s build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit --tsBuildInfoFile dist/tsconfig.check.tsbuildinfo",
    "demo": "node ./demo/server.mjs",
    "dev": "cross-env NODE_ENV=development rollup -c --watch",
    "dev:doppler": "doppler run --config dev -- pnpm run dev",
    "dev:offline": "pnpm run dev",
    "test": "vitest run"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
