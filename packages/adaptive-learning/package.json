{
  "name": "@klicker-uzh/adaptive-learning",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map"
  ],
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^24.10.1",
    "cross-env": "~7.0.3",
    "npm-run-all": "~4.1.5",
    "prettier": "~3.3.3",
    "rollup": "~4.34.9",
    "typescript": "~5.6.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "assert:simulation:v2:release": "node .simulation-build/scripts/assertSimulationRelease.js",
    "build": "run-s build:ts",
    "build:simulation-report": "tsc -p tsconfig.json --outDir .simulation-build --declaration false --declarationMap false --composite false --sourceMap false",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit",
    "dev": "cross-env NODE_ENV=development rollup -c --watch",
    "format:simulation-report": "prettier --write reports/simulation-summary.md",
    "generate:eap-reference": "node --experimental-strip-types scripts/generateEapReference.ts",
    "generate:simulation-report": "node .simulation-build/scripts/generateSimulationReport.js",
    "test": "vitest run test/index.test.ts test/presentation.test.ts test/runtime.test.ts test/scale.test.ts test/calibration.test.ts test/policy.test.ts test/posterior.test.ts test/composite.test.ts test/classification.test.ts test/estimatorVersion.test.ts test/selectionV2.test.ts test/runtimeV2.test.ts test/weights.test.ts",
    "test:irt-v2:release": "run-s test test:simulation test:simulation:v2 test:performance test:simulation:v2:release",
    "test:performance": "vitest run test/runtime.performance.test.ts test/runtimeV2.performance.test.ts",
    "test:run": "run-s test test:simulation test:simulation:v2",
    "test:simulation": "vitest run test/simulation.test.ts",
    "test:simulation:report": "run-s build:simulation-report generate:simulation-report format:simulation-report test:simulation:report:verify",
    "test:simulation:report:verify": "vitest run scripts/generateSimulationReport.test.ts",
    "test:simulation:v2": "vitest run test/internalSimulation.test.ts test/irtV2Simulation.test.ts test/simulationV2Statistics.test.ts",
    "test:simulation:v2:release": "run-s build:simulation-report generate:simulation-report format:simulation-report test:simulation:report:verify verify:simulation:report:determinism assert:simulation:v2:release",
    "verify:simulation:report:determinism": "node .simulation-build/scripts/verifySimulationReportDeterminism.js"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
