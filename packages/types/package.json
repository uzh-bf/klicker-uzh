  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^20.19.11",
    "cross-env": "~7.0.3",
    "esbuild": "~0.25.9",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "rollup-plugin-esbuild": "~6.2.1",
    "typescript": "~5.6.3"
  },
  "peerDependencies": {
    "@hatchet-dev/typescript-sdk": "^1.9.4",
    "@klicker-uzh/prisma": "workspace:*",
    "graphql-yoga": "^3.9.1",
    "ioredis": "^5.4.1",
    "remeda": "^2.15.0"
  },
  "scripts": {
    "build": "run-s build:ts build:types",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
