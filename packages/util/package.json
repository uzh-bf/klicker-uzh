{
  "name": "@klicker-uzh/util",
  "version": "3.1.0",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@klicker-uzh/grading": "workspace:*",
    "@klicker-uzh/prisma": "workspace:*",
    "@klicker-uzh/types": "workspace:*",
    "ioredis": "5.4.1",
    "jose": "5.9.4",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remeda": "2.15.0",
    "unified": "11.0.5",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.1",
    "@rollup/plugin-typescript": "~12.1.4",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "cross-env": "~7.0.3",
    "ioredis": "~5.4.1",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.9",
    "typescript": "~6.0.3",
    "vitest": "~3.2.4"
  },
  "scripts": {
    "build": "run-s --npm-path pnpm build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit --tsBuildInfoFile dist/tsconfig.check.tsbuildinfo",
    "dev": "run-p --npm-path pnpm dev:ts",
    "dev:infisical": "../../util/_run_with_infisical.sh --env dev pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "=24"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./citations": {
      "types": "./dist/citations.d.ts",
      "default": "./dist/citations.js"
    },
    "./client-auth": {
      "types": "./dist/clientAuth.d.ts",
      "default": "./dist/clientAuth.js"
    },
    "./public-url": {
      "types": "./dist/publicUrl.d.ts",
      "default": "./dist/publicUrl.js"
    },
    "./response-example-digest": {
      "types": "./dist/responseExampleDigest.d.ts",
      "default": "./dist/responseExampleDigest.js"
    },
    "./response-example-eligibility": {
      "types": "./dist/responseExampleEligibility.d.ts",
      "default": "./dist/responseExampleEligibility.js"
    },
    "./response-example-runtime": {
      "types": "./dist/responseExampleRuntime.d.ts",
      "default": "./dist/responseExampleRuntime.js"
    }
  },
  "type": "module"
}
