{
  "name": "@klicker-uzh/logging",
  "description": "Structured logging package for KlickerUZH",
  "version": "3.3.0-alpha.60",
  "license": "AGPL-3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-node-resolve": "~15.3.0",
    "@rollup/plugin-typescript": "~12.1.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.1",
    "cross-env": "~7.0.3",
    "jest": "~29.7.0",
    "npm-run-all": "~4.1.5",
    "rollup": "~4.34.2",
    "ts-jest": "~29.2.5",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build": "run-s build:ts",
    "build:test": "pnpm run build",
    "build:ts": "cross-env NODE_ENV=production rollup -c",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "dev": "run-p dev:ts",
    "dev:doppler": "doppler run --config dev -- pnpm run dev",
    "dev:ts": "cross-env NODE_ENV=development rollup -c --watch",
    "test": "NODE_ENV=test jest",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch"
  },
  "engines": {
    "node": "=20"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module"
}
