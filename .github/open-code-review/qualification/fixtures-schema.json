{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "final-ai-review qualification fixture",
  "description": "Public-safe synthetic fixture contract for the offline final-review evaluator. Synthetic values only; no private repository, pull-request, tracker, credential, or provider data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "expected_outcome", "expected_adjudication", "review", "notes"],
  "properties": {
    "schema_version": { "const": "qualification-fixture/v1" },
    "scenario": { "type": "string", "minLength": 1, "maxLength": 80 },
    "expected_outcome": { "enum": ["accepts", "fails-closed"] },
    "expected_adjudication": {
      "anyOf": [
        { "enum": ["blocker", "follow-up", "rejected", "clean"] },
        { "type": "null" }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "summary", "comments"],
      "properties": {
        "schema_version": { "const": "ocr.run-manifest/v1" },
        "status": { "const": "complete" },
        "model": { "type": "string", "minLength": 1 },
        "finish_reason": { "enum": ["stop", "length", "content_filter"] },
        "warnings": {
          "anyOf": [
            { "type": "array", "maxItems": 0 },
            { "type": "null" }
          ]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "comments",
            "files_reviewed",
            "elapsed",
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "coverage": { "enum": ["complete", "partial"] },
            "comments": { "type": "integer", "minimum": 0 },
            "files_reviewed": { "type": "integer", "minimum": 1 },
            "elapsed": { "type": "string", "minLength": 1 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "terminal_state"],
          "properties": {
            "schema_version": { "const": "ocr.run-manifest/v1" },
            "terminal_state": { "const": "complete" }
          }
        },
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "stack_id",
            "ultimate_base",
            "stack_order",
            "layers",
            "path_index"
          ],
          "properties": {
            "schema_version": { "const": "final-ai-stack-manifest/v1" },
            "stack_id": { "type": "string", "minLength": 1, "maxLength": 100 },
            "ultimate_base": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "sha"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            },
            "stack_order": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            },
            "layers": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "pull_request",
                  "base_ref",
                  "base_sha",
                  "head_ref",
                  "head_sha",
                  "title",
                  "files"
                ],
                "properties": {
                  "position": { "type": "integer", "minimum": 1 },
                  "pull_request": { "type": "integer", "minimum": 1 },
                  "base_ref": { "type": "string", "minLength": 1 },
                  "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "head_ref": { "type": "string", "minLength": 1 },
                  "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "title": { "type": "string", "minLength": 1 },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["filename", "status", "additions", "deletions"],
                      "properties": {
                        "filename": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "status": { "type": "string", "minLength": 1 },
                        "additions": { "type": "integer", "minimum": 0 },
                        "deletions": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            },
            "path_index": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["filename", "additions", "deletions", "layers"],
                "properties": {
                  "filename": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "additions": { "type": "integer", "minimum": 0 },
                  "deletions": { "type": "integer", "minimum": 0 },
                  "layers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "comments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "start_line",
              "end_line",
              "category",
              "severity",
              "content"
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "layer_numbers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1 }
              },
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "category": {
                "enum": ["bug", "security", "performance", "maintainability", "test", "style", "documentation", "other"]
              },
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "content": { "type": "string", "minLength": 1, "maxLength": 12000 }
            }
          }
        }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
