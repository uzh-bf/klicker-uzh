+func TestDraftSecondPassClosure(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		round   int
+		finding bool
+	}{{"verified", 2, true}, {"ruled out", 2, false}, {"first pass", 1, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				client := &deadlineFixture{}
+				deps := newTestDeps(client)
+				deps.Tools.Register(&tool.CodeCommentProvider{Collector: deps.CommentCollector})
+
+				client.responses = append(client.responses, fileReadToolCallResponse("read", `{"path":"main.go"}`))
+				if tc.finding {
+					report := taskDoneResponseWithArguments(`{"comments":[{"path":"main.go","existing_code":"package main","content":"Synthetic verified finding"}]}`)
+					report.Choices[0].Message.ToolCalls[0].Function.Name = "code_comment"
+					client.responses = append(client.responses, report)
+				}
+				client.responses = append(client.responses, taskDoneResponse())
+				ctx, cancel := context.WithTimeout(t.Context(), 5*time.Minute)
+				defer cancel()
+				done, _, err := NewRunner(deps).RunReviewRound(ctx, []llm.Message{llm.NewTextMessage("user", "Review main.go")}, "main.go", tc.round)
+				if err != nil || !done || len(client.requests) != len(client.responses) {
+					t.Fatalf("done=%v calls=%d err=%v", done, len(client.requests), err)
+				}
+				for i, req := range client.requests {
+					last := req.Messages[len(req.Messages)-1]
+					reminded := last.Role == "user" && strings.HasPrefix(last.Content.(string), "[ocr:second-pass-wrap-up]")
+					count := 0
+					for _, message := range req.Messages {
+						if text, ok := message.Content.(string); ok && message.Role == "user" && strings.HasPrefix(text, "[ocr:second-pass-wrap-up]") {
+							count++
+						}
+					}
+					if count > 1 {
+						t.Fatal("duplicate wrap-up reminder")
+					}
+					if reminded != (tc.round == 2 && i == 1) {
+						t.Errorf("request %d reminded=%v", i, reminded)
+					}
+				}
+				if got := len(deps.CommentCollector.CommentsForPath("main.go")); got != len(client.responses)-2 {
+					t.Fatalf("collected %d findings", got)
+				}
+			})
+		})
