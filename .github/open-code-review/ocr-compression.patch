+func TestCompressionTelemetryPreservesFailureAndNoWorkResults(t *testing.T) {
+	for _, outcome := range []string{"unchanged", "failed", "cancelled", "oversized", "disabled", "no_work"} {
+		t.Run(outcome, func(t *testing.T) {
+			var progress bytes.Buffer
+			defer stdout.Swap(&progress)()
+			t_tempDir = t.TempDir()
+			client := &compressionRecordingClient{}
+			tmpl := template.Template{MaxTokens: 1000, MemoryCompressionTask: template.LlmConversation{Messages: []template.ChatMessage{{Role: "user", Content: "{{context}}"}}}}
+			msgs := []llm.Message{msg("system", "immutable"), msg("user", "instructions")}
+			for i := 0; i < 8; i++ {
+				msgs = append(msgs, msg("assistant", strings.Repeat("context ", 150)), msg("tool", strings.Repeat("evidence ", 150)))
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			empty := ""
+			switch outcome {
+			case "unchanged":
+				client.response = &llm.ChatResponse{Choices: []llm.Choice{{Message: llm.ResponseMessage{Content: &empty}}}}
+			case "failed":
+				client.err = fmt.Errorf("private synthetic provider detail")
+			case "cancelled":
+				cancel()
+				client.err = context.Canceled
+			case "oversized":
+				huge := strings.Repeat("summary ", 5000)
+				client.response = &llm.ChatResponse{Choices: []llm.Choice{{Message: llm.ResponseMessage{Content: &huge}}}}
+			case "disabled":
+				tmpl.MemoryCompressionTask.Messages = nil
+				msgs = msgs[:2]
+			case "no_work":
+				msgs = msgs[:2]
+			}
+			r := newTestRunner(client, tmpl)
+			got, err := r.runCompression(ctx, msgs, "private-task-key")
+			if !reflect.DeepEqual(got, msgs) {
+				t.Fatal("instrumentation changed unchanged-history result")
+			}
+			wantError := outcome == "failed" || outcome == "cancelled" || outcome == "oversized"
+			if (err != nil) != wantError {
+				t.Fatal("unexpected compression error behavior")
+			}
+			if outcome == "disabled" || outcome == "no_work" {
+				if len(client.requests) != 0 || strings.Contains(progress.String(), "compression_started ") {
+					t.Fatal("no-work path counted as request")
+				}
+			} else {
+				status := outcome
+				if status == "oversized" {
+					status = "failed"
+				}
+				expected := fmt.Sprintf("[ocr] compression_finished outcome=%s before_estimated_tokens=%d after_estimated_tokens=%d\n", status, CountMessagesTokens(msgs), CountMessagesTokens(msgs))
+				if len(client.requests) != 1 || !strings.Contains(progress.String(), expected) {
+					t.Fatal("wrong telemetry result or request count")
+				}
+			}
+			if strings.Contains(progress.String(), "private-") || strings.Contains(progress.String(), "provider detail") {
+				t.Fatal("telemetry leaked private details")
+			}
+		})
+	}
+}
