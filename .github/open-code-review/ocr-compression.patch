+// fitRenderedGroups reserves all rendered rules and the existing maximum plan
+// output before dispatch. Splitting changes execution units, never selection.
+func (a *Agent) fitRenderedGroups(groups []FileGroup) []FileGroup {
+	var fitted []FileGroup
+	var visit func(FileGroup)
+	visit = func(g FileGroup) {
+		plan, reservation := "", 0
+		total, largest := diffsChurn(g.Diffs)
+		if pt := a.args.Template.PlanTask; pt != nil && len(pt.Messages) > 0 &&
+			a.args.Template.PlanRequired(len(g.Diffs), total, largest) {
+			plan = "reserved plan"
+			for _, m := range a.args.Template.MainTask.Messages {
+				reservation += strings.Count(m.Content, "{{plan_guidance}}") * a.args.Template.CompletionTokenLimit()
+			}
+		}
+		messages := a.buildMainTaskMessages(a.resolveGroupSystemRule(g.Diffs),
+			a.buildChangeFilesExceptGroup(g.Diffs), buildConcatenatedDiffs(g.Diffs), plan, "")
+		tokens := llmloop.CountMessagesTokens(messages) + reservation
+		if len(g.Diffs) > 1 && tokens > llmloop.PromptTokenLimit(a.args.Template.MaxTokens) {
+			mid := len(g.Diffs) / 2
+			visit(FileGroup{Label: g.Label, Diffs: g.Diffs[:mid]})
+			visit(FileGroup{Label: g.Label, Diffs: g.Diffs[mid:]})
+			return
+		}
+		fitted = append(fitted, g)
+	}
+	for _, g := range groups {
+		visit(g)
+	}
+	return fitted
+}
