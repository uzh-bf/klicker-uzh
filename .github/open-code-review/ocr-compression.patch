+func TestCompressionFrozenPromptAndRollingSummary(t *testing.T) {
+	var progress bytes.Buffer
+	defer stdout.Swap(&progress)()
+	t_tempDir = t.TempDir()
+	client := &compressionRecordingClient{}
+	r := newTestRunner(client, template.Template{MaxTokens: 1000, MemoryCompressionTask: template.LlmConversation{Messages: []template.ChatMessage{{Role: "user", Content: "{{context}}"}}}})
+	original := []llm.Message{msg("system", strings.Repeat("system ", 150)), msg("user", strings.Repeat("review ", 150))}
+	messages := append([]llm.Message(nil), original...)
+	for i := 0; i < 8; i++ {
+		messages = append(messages, msg("assistant", strings.Repeat("evidence ", 150)), msg("tool", strings.Repeat("result ", 150)))
+	}
+	got, err := r.runCompression(context.Background(), messages, "synthetic.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got[:2], original) {
+		t.Fatal("compression changed the immutable review instructions")
+	}
+	if len(got) < 3 || got[2].Role != "user" {
+		t.Fatal("summary must occupy a compressible message after the immutable prefix")
+	}
+	if CountMessagesTokens(got) >= PromptTokenLimit(1000) {
+		t.Fatal("compression did not reserve the fixed prompt and summary")
+	}
+	expectedFirst := fmt.Sprintf("[ocr] compression_finished outcome=rebuilt before_estimated_tokens=%d after_estimated_tokens=%d\n", CountMessagesTokens(messages), CountMessagesTokens(got))
+	if !strings.Contains(progress.String(), expectedFirst) {
+		t.Fatal("compression estimates do not describe the returned snapshot")
+	}
+	previous := got[2].ExtractText()
+	for i := 0; i < 8; i++ {
+		got = append(got, msg("assistant", strings.Repeat("new evidence ", 150)), msg("tool", strings.Repeat("new result ", 150)))
+	}
+	again, err := r.runCompression(context.Background(), got, "synthetic.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(again[:2], original) {
+		t.Fatal("repeated compression accumulated summaries in the immutable prefix")
+	}
+	if len(client.requests) != 2 {
+		t.Fatalf("expected two useful compressions, got %d", len(client.requests))
+	}
+	if !strings.Contains(client.requests[1].Messages[0].ExtractText(), previous) {
+		t.Fatal("recompression lost the previous summary's evidence")
+	}
+	if CountMessagesTokens(again) >= PromptTokenLimit(1000) {
+		t.Fatal("recompression retained too much active history")
+	}
+	if strings.Count(progress.String(), "compression_started ") != len(client.requests) || strings.Count(progress.String(), "compression_finished outcome=rebuilt ") != len(client.requests) {
+		t.Fatal("telemetry lifecycle does not match actual summarization requests")
+	}
+	if strings.Contains(progress.String(), "synthetic.go") || strings.Contains(progress.String(), "bounded current summary") {
+		t.Fatal("telemetry contains task or summary content")
+	}
+}
