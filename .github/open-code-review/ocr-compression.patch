+type compressionRecordingClient struct {
+	requests []llm.ChatRequest
+	response *llm.ChatResponse
+	err      error
+}
+
+func (c *compressionRecordingClient) CompletionsWithCtx(_ context.Context, req llm.ChatRequest) (*llm.ChatResponse, error) {
+	c.requests = append(c.requests, req)
+	if c.response != nil || c.err != nil {
+		return c.response, c.err
+	}
+	text := "bounded current summary"
+	return &llm.ChatResponse{Choices: []llm.Choice{{Message: llm.ResponseMessage{Content: &text}}}}, nil
+}
