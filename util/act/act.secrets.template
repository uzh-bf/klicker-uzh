# Template for act.secrets - copy this to act.secrets and modify as needed
# The act.secrets file should be gitignored and contains secrets for local testing

APP_SECRET=abcd
CYPRESS_RECORD_KEY=dummy-key-for-local-testing
GITHUB_TOKEN=will-be-auto-populated-from-gh-cli

# IMPORTANT: The run-act-local.sh script will automatically populate GITHUB_TOKEN
# from your GitHub CLI authentication. Make sure you have gh CLI installed and
# authenticated:
#
#   brew install gh
#   gh auth login
#
# This is required because act has a bug that requires authentication even for
# public GitHub Actions repositories.

# Note: The setup script will automatically create act.secrets from this template