#!/usr/bin/env bash

set -Eeuo pipefail

method='GET'
endpoint=''
public_access=''
read_input=false
while (($# > 0)); do
  case "$1" in
    api)
      shift
      ;;
    --method)
      method=$2
      shift 2
      ;;
    -H | -f | -F)
      case "$2" in
        allows_public_repositories=*) public_access=${2#*=} ;;
      esac
      shift 2
      ;;
    --input)
      read_input=true
      shift 2
      ;;
    /*)
      endpoint=$1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

state=$(cat "$FAKE_STATE" 2>/dev/null || printf 'before')
if [[ "$read_input" == true ]]; then
  payload=$(cat)
fi
if [[ "$FAKE_SCENARIO" == roles-* ]]; then
  printf '%s %s\n' "$method" "$endpoint" >>"${FAKE_STATE}.calls"
  if [[ "$endpoint" =~ ^/orgs/uzh-bf/actions/runners/([1-8])/labels$ ]]; then
    runner_id=${BASH_REMATCH[1]}
    labels_file="${FAKE_STATE}.labels-${runner_id}"
    [[ "$FAKE_SCENARIO" != 'roles-denied' ]] || exit 1
    labels='["docker","public-pr-arm64","playwright","keep-me"]'
    [[ ! -f "$labels_file" ]] || labels=$(cat "$labels_file")
    if [[ "$FAKE_SCENARIO" == 'roles-exact' && ! -f "$labels_file" ]]; then
      case "$runner_id" in
        1 | 5) labels=$(jq -c '. + ["playwright-build","playwright-shard"]' <<<"$labels") ;;
        2 | 6) labels=$(jq -c '. + ["playwright-shard"]' <<<"$labels") ;;
      esac
    fi
    if [[ "$method" == 'PUT' ]]; then
      [[ "$FAKE_SCENARIO" != 'roles-write-failure' || "$runner_id" != 2 ]] || exit 1
      jq -e 'keys == ["labels"] and (.labels | type == "array")' <<<"$payload" >/dev/null
      jq -c '.labels' <<<"$payload" >"$labels_file"
      exit 0
    fi
    [[ "$method" == 'GET' ]] || exit 1
    reads_file="${FAKE_STATE}.reads-${runner_id}"
    reads=$(cat "$reads_file" 2>/dev/null || printf 0)
    printf '%s' "$((reads + 1))" >"$reads_file"
    if [[ "$FAKE_SCENARIO" == 'roles-concurrent' && "$runner_id" == 2 && "$reads" -ge 1 ]]; then
      labels=$(jq -c '. + ["concurrent-label"]' <<<"$labels")
    fi
    if [[ -f "$labels_file" && "$runner_id" == 2 ]]; then
      [[ "$FAKE_SCENARIO" != 'roles-readback-failure' ]] || exit 1
      if [[ "$FAKE_SCENARIO" == 'roles-readback-mismatch' ]]; then
        labels='["docker","public-pr-arm64","playwright","keep-me"]'
      fi
    fi
    if [[ "$FAKE_SCENARIO" == 'roles-stale-prior' ]]; then
      labels=$(jq -c '. + ["unrecorded-label"]' <<<"$labels")
    fi
    document=$(jq -nc --argjson custom "$labels" '{labels: (
      (["self-hosted","Linux","ARM64"] | map({name:.,type:"read-only"})) +
      ($custom | map({name:.,type:"custom"})))} | .total_count = (.labels|length)')
    if [[ "$FAKE_SCENARIO" == 'roles-incomplete-labels' ]]; then
      document=$(jq -c '.total_count += 1' <<<"$document")
    fi
    printf '%s\n' "$document"
    exit 0
  fi
  [[ "$method" == 'GET' ]] || exit 1
fi
if [[ "$method" == 'PATCH' ]]; then
  if [[ "$read_input" == true ]]; then
    jq -e '.name == "public-pr-arm64" and .visibility == "selected" and
      .allows_public_repositories == false and .restricted_to_workflows == true and
      .selected_workflows == []' <<<"$payload" >/dev/null || exit 1
    public_access=false
  fi
  if [[ "$public_access" == 'false' ]]; then
    [[ "$FAKE_SCENARIO" != 'disable-failure' ]] || exit 1
    printf 'disabled' >"$FAKE_STATE"
  else
    [[ "$state" == 'repositories' ]] || exit 1
    [[ "$FAKE_SCENARIO" != 'enable-failure' ]] || exit 1
    printf 'after' >"$FAKE_STATE"
  fi
  printf '{}\n'
  exit 0
fi
if [[ "$method" == 'PUT' ]]; then
  jq -e '.selected_repository_ids == [42]' <<<"$payload" >/dev/null || exit 1
  [[ "$state" == 'disabled' ]] || exit 1
  [[ "$FAKE_SCENARIO" != 'repository-failure' ]] || exit 1
  printf 'repositories' >"$FAKE_STATE"
  exit 0
fi

case "$endpoint" in
  /repos/uzh-bf/klicker-uzh)
    printf '{"id":42,"full_name":"uzh-bf/klicker-uzh","private":false,"default_branch":"v3"}\n'
    ;;
  /repos/uzh-bf/klicker-uzh/contents/.github/workflows/public-pr-playwright-shards.yml)
    printf '{"type":"file","path":".github/workflows/public-pr-playwright-shards.yml"}\n'
    ;;
  /orgs/uzh-bf/actions/runner-groups)
    selected='[]'
    visibility='all'
    allows_public='false'
    restricted='false'
    inherited='false'
    read_only='false'
    if [[ "$FAKE_SCENARIO" == 'exact' || "$FAKE_SCENARIO" == roles-* || "$state" == 'after' ]]; then
      selected='["uzh-bf/klicker-uzh/.github/workflows/public-pr-playwright-shards.yml@refs/heads/v3"]'
      visibility='selected'
      allows_public='true'
      restricted='true'
      [[ "$FAKE_SCENARIO" != 'roles-policy-drift' ]] || allows_public='false'
    elif [[ "$FAKE_SCENARIO" == 'extra-workflow' ]]; then
      selected='["uzh-bf/klicker-uzh/.github/workflows/public-pr-playwright-shards.yml@refs/heads/v3","uzh-bf/klicker-uzh/.github/workflows/check.yml@refs/heads/v3"]'
      visibility='selected'
      allows_public='true'
      restricted='true'
    elif [[ "$FAKE_SCENARIO" == 'inherited' ]]; then
      inherited='true'
    elif [[ "$FAKE_SCENARIO" == 'read-only' ]]; then
      read_only='true'
    fi
    printf '{"total_count":1,"runner_groups":[{"id":7,"name":"public-pr-arm64","default":false,"visibility":"%s","allows_public_repositories":%s,"restricted_to_workflows":%s,"selected_workflows":%s,"inherited":%s,"workflow_restrictions_read_only":%s}]}\n' \
      "$visibility" "$allows_public" "$restricted" "$selected" "$inherited" "$read_only"
    ;;
  /orgs/uzh-bf/actions/runner-groups/7/repositories)
    if [[ "$FAKE_SCENARIO" == 'extra-repository' && "$state" != 'after' ]]; then
      printf '{"total_count":2,"repositories":[{"id":42,"full_name":"uzh-bf/klicker-uzh"},{"id":99,"full_name":"uzh-bf/other"}]}\n'
    elif [[ "$FAKE_SCENARIO" == 'exact' || "$FAKE_SCENARIO" == roles-* || "$state" == 'after' ]]; then
      printf '{"total_count":1,"repositories":[{"id":42,"full_name":"uzh-bf/klicker-uzh"}]}\n'
    else
      printf '{"total_count":0,"repositories":[]}\n'
    fi
    ;;
  /orgs/uzh-bf/actions/runner-groups/7/runners)
    count=8
    [[ "$FAKE_SCENARIO" == 'missing-runner' ]] && count=7
    total=$count
    [[ "$FAKE_SCENARIO" != 'roles-incomplete-membership' ]] || total=9
    printf '{"total_count":%s,"runners":[' "$total"
    for ((index = 1; index <= count; index++)); do
      ((index > 1)) && printf ','
      status='online'
      if [[ "$FAKE_SCENARIO" == roles-* && ( "$index" == 3 || "$index" == 4 || "$index" == 7 || "$index" == 8 ) ]]; then
        status='offline'
      fi
      busy=false
      [[ "$FAKE_SCENARIO" != 'roles-busy' || "$index" != 1 ]] || busy=true
      printf '{"id":%s,"name":"public-pr-arm64-%02d","status":"%s","busy":%s}' "$index" "$index" "$status" "$busy"
    done
    printf ']}\n'
    ;;
  *)
    printf 'unexpected endpoint: %s %s\n' "$method" "$endpoint" >&2
    exit 1
    ;;
esac
