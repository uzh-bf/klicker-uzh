{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!playwright/**",
      "!**/ops.ts",
      "!**/ops.schema.json",
      "!**/nexus-typegen.ts",
      "!**/client.json",
      "!**/server.json",
      "!packages/prisma/src/prisma/client/**",
      "!packages/graphql/instrumented/**",
      "!packages/markdown/components.css",
      "!packages/markdown/utilities.css",
      "!**/public/**",
      "!**/static/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/frontend-manage/src/components/activities/creation/microLearning/MicroLearningWizard.tsx",
        "apps/frontend-manage/src/components/activities/creation/practiceQuiz/PracticeQuizWizard.tsx",
        "apps/frontend-manage/src/components/catalog/administration/AddObjectToCatalogModal.tsx",
        "apps/frontend-manage/src/components/courses/PointCorrectionsModal.tsx",
        "apps/frontend-manage/src/components/courses/modals/CourseManipulationModal.tsx",
        "apps/frontend-manage/src/components/elements/manipulation/useValidationSchema.ts",
        "apps/frontend-pwa/src/components/forms/CreateAccountForm.tsx",
        "apps/frontend-pwa/src/components/forms/UpdateAccountInfoForm.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "warn"
          }
        }
      }
    },
    {
      "includes": ["email/23FS Beta Notification.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownProperty": "warn"
          }
        }
      }
    }
  ]
}
